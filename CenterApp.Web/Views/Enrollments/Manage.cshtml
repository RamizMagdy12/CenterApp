@model ManageEnrollmentsVm
@using System.Text.Json
<div class="mb-3">
    <strong>@Model.GroupName</strong> —
    @L.Get("Enroll.Enrolled"): @Model.Enrolled.Count / @(Model.Capacity == 0 ? "∞" : Model.Capacity.ToString()) —
    @L.Get("Groups.MonthlyFee"): @Model.MonthlyFee.ToString("N2")
</div>

<div class="row g-2 mb-3">
    <div class="col-md-6">
        <input id="enrStudent" list="enrList" class="form-control" placeholder="@L.Get("Enroll.UnassignedPh")" autocomplete="off" />
        <datalist id="enrList">
            @foreach (var a in Model.Available)
            {
                <option value="@a.Text"></option>
            }
        </datalist>
    </div>
    <div class="col-md-3"><input id="enrFee" type="number" min="0" step="0.01" class="form-control" placeholder="@L.Get("Enroll.CustomFeePh")" /></div>
    <div class="col-md-3"><button class="btn btn-success w-100" onclick="addEnrollment()">@L.Get("Enroll.Register")</button></div>
</div>

<table class="table table-sm table-striped align-middle">
    <thead><tr><th>@L.Get("Common.Student")</th><th>@L.Get("Common.Phone")</th><th>@L.Get("Enroll.JoinedOn")</th><th>@L.Get("Enroll.CustomFee")</th><th></th></tr></thead>
    <tbody>
        @foreach (var e in Model.Enrolled)
        {
            <tr>
                <td>@e.StudentName</td>
                <td>@e.Phone</td>
                <td>@e.JoinedAt.ToString("yyyy-MM-dd")</td>
                <td>@(e.CustomFee?.ToString("N2") ?? "-")</td>
                <td><button class="btn btn-sm btn-outline-danger" onclick="removeEnrollment(@e.EnrollmentId)">@L.Get("Enroll.Unregister")</button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="openForm('@Url.Action("TransferForm", "Students", new { id = e.StudentId, from = Model.GroupId })', enrTransferTitle, true)">@L.Get("Enroll.Transfer")</button>
                </td>

            </tr>
        }
    </tbody>
</table>

<script>
    var stuMap = @Html.Raw(JsonSerializer.Serialize(Model.Available.ToDictionary(a => a.Text, a => a.Id)));
    var manageUrl = '@Url.Action("Manage", "Enrollments", new { groupId = Model.GroupId })';
    var enrTransferTitle = @Json.Serialize(L.Get("Students.TransferTitle").Value);
    var enrGroupStudents = @Json.Serialize(L.Get("Groups.Students").Value);
    var pickStudent = @Json.Serialize(L.Get("Enroll.PickStudent").Value);
    var removeAsk = @Json.Serialize(L.Get("Enroll.RemoveAsk").Value);
    var removeYes = @Json.Serialize(L.Get("Enroll.RemoveYes").Value);

    function reopen() { openForm(manageUrl, enrGroupStudents, true); }

    function addEnrollment() {
        var id = stuMap[$('#enrStudent').val()];
        if (!id) { notify('warning', pickStudent); return; }
        postJson('@Url.Action("Add", "Enrollments")',
            { groupId: @Model.GroupId, studentId: id, customFee: $('#enrFee').val() }, reopen);
    }

    function removeEnrollment(id) {
        askConfirm(removeAsk, removeYes).then(function (ok) {
            if (ok) postJson('@Url.Action("Remove", "Enrollments")', { id: id }, reopen);
        });
    }

    $('#appModal').off('hidden.bs.modal.enr').one('hidden.bs.modal.enr', function () { location.reload(); });
</script>
