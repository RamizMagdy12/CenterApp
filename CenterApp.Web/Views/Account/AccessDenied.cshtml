@{
    ViewData["Title"] = L.Get("Auth.DeniedTitle").Value;
}
<div class="panel text-center" style="max-width:520px;margin:60px auto;">
    <div style="font-size:56px;color:#c53030;"><i class="bi bi-shield-lock"></i></div>
    <h3 class="mt-2">@L.Get("Auth.DeniedHeading")</h3>
    <p class="text-muted">@L.Get("Auth.DeniedHint")</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">@L.Get("Auth.BackHome")</a>
</div>
