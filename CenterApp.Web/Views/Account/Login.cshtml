@model LoginVm
@{
    Layout = null;
}
@{
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<!DOCTYPE html>
<html lang="@(isAr ? "ar" : "en")" dir="@(isAr ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@L.Get("Auth.LoginTitle") - @L.Get("App.Name")</title>
    <partial name="_Favicon" />
    <link rel="stylesheet" href="~/lib/fontsource-cairo/400.css" />
    <link rel="stylesheet" href="~/lib/fontsource-cairo/600.css" />
    <link rel="stylesheet" href="~/lib/fontsource-cairo/700.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                display: grid;
                place-items: center;
                padding: 20px;
                font-family: 'Cairo', Tahoma, Arial, sans-serif;
                color: #1a2c3a;
                background: #102433;
                overflow-x: hidden;
            }

            /* ───────── الخلفية المتحركة ───────── */
            .bg {
                position: fixed;
                inset: 0;
                overflow: hidden;
                z-index: 0;
            }

            .bg-gradient {
                position: absolute;
                inset: 0;
                background: linear-gradient(-45deg, #102433, #163044, #146278, #1a7a86, #102433);
                background-size: 400% 400%;
                animation: gradientMove 18s ease infinite;
            }

            @@keyframes gradientMove {
                0% {
                    background-position: 0% 50%;
                }

                50% {
                    background-position: 100% 50%;
                }

                100% {
                    background-position: 0% 50%;
                }
            }

            .orb {
                position: absolute;
                border-radius: 50%;
                filter: blur(70px);
                opacity: .45;
            }

                .orb.o1 {
                    width: 420px;
                    height: 420px;
                    background: #146278;
                    top: -120px;
                    inset-inline-start: -100px;
                    animation: drift1 22s ease-in-out infinite;
                }

                .orb.o2 {
                    width: 480px;
                    height: 480px;
                    background: #2d8a99;
                    bottom: -160px;
                    inset-inline-end: -120px;
                    animation: drift2 26s ease-in-out infinite;
                }

                .orb.o3 {
                    width: 300px;
                    height: 300px;
                    background: #163044;
                    top: 40%;
                    left: 45%;
                    animation: drift3 30s ease-in-out infinite;
                }

            @@keyframes drift1 {
                0%, 100% {
                    transform: translate(0,0);
                }

                50% {
                    transform: translate(160px, 120px);
                }
            }

            @@keyframes drift2 {
                0%, 100% {
                    transform: translate(0,0);
                }

                50% {
                    transform: translate(-180px, -100px);
                }
            }

            @@keyframes drift3 {
                0%, 100% {
                    transform: translate(0,0) scale(1);
                }

                50% {
                    transform: translate(-120px, 80px) scale(1.25);
                }
            }

            .floaters {
                position: absolute;
                inset: 0;
            }

            .floater {
                position: absolute;
                bottom: 0;
                color: #fff;
                animation: floatUp linear infinite;
                will-change: transform;
            }

            @@keyframes floatUp {
                0% {
                    transform: translateY(110vh) rotate(0deg);
                    opacity: 0;
                }

                10% {
                    opacity: var(--o);
                }

                90% {
                    opacity: var(--o);
                }

                100% {
                    transform: translateY(-120vh) rotate(360deg);
                    opacity: 0;
                }
            }

            /* فيديو حقيقي (بيظهر لو الملف موجود) */
            .bg-video {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                opacity: 0;
                transition: opacity 1.2s ease;
            }

                .bg-video.ready {
                    opacity: 1;
                }

            .bg-overlay {
                position: absolute;
                inset: 0;
                background: rgba(16, 36, 51, .35);
            }

            @@media (prefers-reduced-motion: reduce) {
                .bg-gradient, .orb, .floater {
                    animation: none;
                }

                .floaters {
                    display: none;
                }
            }

            /* ───────── كارت الدخول ───────── */
            .login-card {
                position: relative;
                z-index: 2;
                width: 100%;
                max-width: 540px;
                background: rgba(255, 255, 255, .9);
                -webkit-backdrop-filter: blur(10px);
                backdrop-filter: blur(10px);
                border-radius: 14px;
                padding: 34px 44px 40px;
                box-shadow: 0 20px 60px rgba(0, 0, 0, .4);
                animation: cardIn .7s ease both;
            }

            @@keyframes cardIn {
                from {
                    opacity: 0;
                    transform: translateY(24px);
                }

                to {
                    opacity: 1;
                    transform: none;
                }
            }

            .brand {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
                margin-bottom: 18px;
            }

            .brand-logo {
                width: 48px;
                height: 48px;
                border-radius: 14px;
                color: #fff;
                font-size: 26px;
                display: grid;
                place-items: center;
                background: linear-gradient(135deg, #146278, #2d8a99);
            }

            .brand-name {
                font-size: 34px;
                font-weight: 700;
                color: #163044;
            }

            h1 {
                text-align: center;
                font-size: 24px;
                font-weight: 700;
                margin: 0 0 4px;
            }

            .sub {
                text-align: center;
                color: #555;
                margin: 0 0 22px;
            }

            label {
                display: block;
                font-size: 15px;
                margin-bottom: 6px;
            }

            .row-label {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .row-label a {
                    font-size: 12.5px;
                    color: #6b6f8d;
                    text-decoration: none;
                }

            .field {
                width: 100%;
                height: 46px;
                border: 1px solid #e3e3ea;
                border-radius: 4px;
                padding: 0 14px;
                font-size: 14px;
                font-family: inherit;
                background: #fff;
                outline: none;
                margin-bottom: 18px;
            }

                .field:focus {
                    border-color: #146278;
                }

            .pw {
                position: relative;
            }

                .pw button {
                    position: absolute;
                    inset-inline-start: 10px;
                    top: 0;
                    height: 46px;
                    border: 0;
                    background: none;
                    color: #777;
                    cursor: pointer;
                    font-size: 18px;
                }

                .pw .field {
                    padding-inline-start: 40px;
                }

            .btn-login {
                width: 100%;
                height: 52px;
                border: 0;
                border-radius: 4px;
                color: #fff;
                font-size: 18px;
                font-weight: 600;
                font-family: inherit;
                cursor: pointer;
                background: linear-gradient(90deg, #163044, #146278);
            }

                .btn-login:hover {
                    filter: brightness(1.08);
                }

            .err {
                background: #fde8e8;
                color: #b42318;
                border-radius: 6px;
                padding: 10px 14px;
                font-size: 14px;
                margin-bottom: 16px;
            }

            .login-lang {
                position: fixed;
                top: 16px;
                inset-inline-end: 16px;
                z-index: 2;
                background: rgba(255, 255, 255, .92);
                border-radius: 10px;
                padding: 4px;
            }

            .login-lang .lang-current {
                list-style: none;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                cursor: pointer;
                font-weight: 700;
                font-size: 13px;
            }

            .login-lang .lang-current::-webkit-details-marker {
                display: none;
            }

            .login-lang .lang-menu {
                position: absolute;
                top: calc(100% + 8px);
                inset-inline-end: 0;
                min-width: 168px;
                background: #fff;
                border-radius: 12px;
                padding: 6px;
                box-shadow: 0 12px 30px rgba(22, 48, 68, .12);
            }

            .login-lang .lang-opt {
                display: flex;
                align-items: center;
                gap: 8px;
                width: 100%;
                border: 0;
                background: transparent;
                font: inherit;
                font-weight: 700;
                padding: 8px 10px;
                border-radius: 8px;
                cursor: pointer;
            }

            .login-lang .lang-opt.on {
                background: #e7f4f6;
            }

            .login-lang .lang-code {
                background: #e7f4f6;
                color: #146278;
                border-radius: 6px;
                font-size: 10px;
                font-weight: 700;
                padding: 2px 6px;
            }

            .login-lang .lang-opt .bi-check2 {
                margin-inline-start: auto;
                color: #146278;
            }

            @@media (max-width: 575.98px) {
                .login-card {
                    padding: 26px 22px 30px;
                }

                .brand-name {
                    font-size: 28px;
                }
            }
    </style>
</head>
<body>
    <div class="login-lang"><partial name="_LangSwitch" /></div>

    <div class="bg" aria-hidden="true">
        <div class="bg-gradient"></div>
        <div class="orb o1"></div>
        <div class="orb o2"></div>
        <div class="orb o3"></div>
        <div class="floaters" id="floaters"></div>
        <div class="bg-overlay"></div>
    </div>

    <div class="login-card">
        <div class="brand">
            <span class="brand-logo"><i class="bi bi-mortarboard-fill"></i></span>
            <span class="brand-name">@L.Get("App.Name")</span>
        </div>

        <h1>@L.Get("Auth.LoginTitle")</h1>
        <p class="sub">@L.Get("Auth.LoginSub")</p>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="err">@Model.Error</div>
        }

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />

            <label for="UserName">@L.Get("Auth.UserOrEmail")</label>
            <input asp-for="UserName" class="field" placeholder="@L.Get("Auth.UserOrEmailPh")" autocomplete="username" autofocus />

            <div class="row-label">
                <label for="Password">@L.Get("Auth.Password")</label>
                <a href="#" onclick="forgot(); return false;">@L.Get("Auth.Forgot")</a>
            </div>
            <div class="pw">
                <input asp-for="Password" type="password" class="field" autocomplete="current-password" />
                <button type="button" id="togglePw" aria-label="@L.Get("Auth.ShowPassword")"><i class="bi bi-eye"></i></button>
            </div>

            <button type="submit" class="btn-login">@L.Get("Auth.SignIn")</button>
        </form>
    </div>

    <script src="~/lib/sweetalert2/dist/sweetalert2.all.min.js"></script>
    <script>
            // ── أيقونات تعليمية بتطفو في الخلفية
            (function () {
                var icons = ['bi-book', 'bi-mortarboard', 'bi-pencil', 'bi-calculator', 'bi-lightbulb',
                    'bi-journal-text', 'bi-backpack', 'bi-globe2', 'bi-rulers', 'bi-palette'];
                var wrap = document.getElementById('floaters');
                var count = window.innerWidth < 576 ? 12 : 24;
                for (var i = 0; i < count; i++) {
                    var el = document.createElement('i');
                    el.className = 'bi ' + icons[i % icons.length] + ' floater';
                    el.style.left = (Math.random() * 100) + '%';
                    el.style.fontSize = (24 + Math.random() * 44) + 'px';
                    el.style.animationDuration = (18 + Math.random() * 22) + 's';
                    el.style.animationDelay = '-' + (Math.random() * 30) + 's';
                    el.style.setProperty('--o', (0.10 + Math.random() * 0.16).toFixed(2));
                    wrap.appendChild(el);
                }
            })();

            // ── فيديو حقيقي لو موجود: wwwroot/video/login-bg.mp4
            (function () {
                var src = '@Url.Content("~/video/login-bg.mp4")';
                fetch(src, { method: 'HEAD' }).then(function (r) {
                    if (!r.ok) return;
                    var v = document.createElement('video');
                    v.className = 'bg-video';
                    v.src = src;
                    v.autoplay = true; v.muted = true; v.loop = true; v.playsInline = true;
                    v.setAttribute('muted', ''); v.setAttribute('playsinline', '');
                    v.addEventListener('canplay', function () { v.classList.add('ready'); });
                    document.querySelector('.bg').insertBefore(v, document.querySelector('.bg-overlay'));
                    v.play().catch(function () { });
                }).catch(function () { });
            })();

            document.getElementById('togglePw').addEventListener('click', function () {
                var i = document.getElementById('Password');
                var show = i.type === 'password';
                i.type = show ? 'text' : 'password';
                this.innerHTML = show ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
            });

            function forgot() {
                Swal.fire({ icon: 'info', title: @Json.Serialize(L.Get("Auth.Forgot").Value), text: @Json.Serialize(L.Get("Auth.ForgotHint").Value), confirmButtonText: @Json.Serialize(L.Get("Common.Ok").Value), confirmButtonColor: '#146278' });
            }
    </script>
</body>
</html>