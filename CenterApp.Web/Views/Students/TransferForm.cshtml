@model TransferFormVm
@using System.Text.Json
@functions {
    string Label(GroupPick p)
    {
        var s = p.Name;
        if (p.Code.Length > 0) s += $" ({p.Code})";
        if (p.Free >= 0) s += " — " + L.Get("Groups.SeatsLeft", p.Free).Value;
        if (p.Why != null) s += $" — {p.Why}";
        return s;
    }
}

<div class="mb-3"><strong>@Model.StudentName</strong> — @L.Get("Students.CurrentCode") <b dir="ltr">@Model.Code</b></div>

@if (Model.Current.Count == 0)
{
    <div class="alert alert-warning">@L.Get("Students.NotEnrolledNow")</div>
}
else
{
    <form id="trForm" onsubmit="return false;">
        <input type="hidden" name="studentId" value="@Model.StudentId" />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">@L.Get("Students.FromGroup")</label>
                <select name="fromGroupId" id="trFrom" class="form-select">
                    @foreach (var c in Model.Current)
                    {
                        <option value="@c.Id" selected="@(c.Id == Model.FromGroupId)">@c.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">@L.Get("Students.ToGroup")</label>
                <select name="toGroupId" id="trTo" class="form-select">
                    <option value="">@L.Get("Common.Choose")</option>
                    @foreach (var t in Model.Targets)
                    {
                        <option value="@t.Id" data-next="@t.NextCode" disabled="@t.Disabled">@Label(t)</option>
                    }
                </select>
            </div>

            <div class="col-12"><div id="trPreview" class="alert alert-info mb-0" style="display:none"></div></div>

            <div class="col-12">
                <small class="text-muted">
                    @L.Get("Students.TransferInvoiceHint")
                </small>
            </div>

            <div class="col-12"><button class="btn btn-success" onclick="doTransfer()">@L.Get("Students.DoTransfer")</button></div>
        </div>
    </form>

    <script>
        var codeGroupId = @Model.CodeGroupId;
        var curCode = @Html.Raw(JsonSerializer.Serialize(Model.Code));
        var codeWillChange = @Json.Serialize(L.Get("Students.CodeWillChange").Value);
        var codeStays = @Json.Serialize(L.Get("Students.CodeStays").Value);
        var pickNewGroup = @Json.Serialize(L.Get("Students.PickNewGroup").Value);
        var transferAsk = @Json.Serialize(L.Get("Students.TransferAsk").Value);
        var transferYes = @Json.Serialize(L.Get("Students.TransferYes").Value);
        var transferred = @Json.Serialize(L.Get("Students.Transferred").Value);
        var printStudentCard = @Json.Serialize(L.Get("Students.PrintStudentCard").Value);
        var okText = @Json.Serialize(L.Get("Common.Ok").Value);

        function preview() {
            var to = $('#trTo option:selected');
            if (!to.val()) { $('#trPreview').hide(); return; }

            var from = parseInt($('#trFrom').val());
            var recode = (codeGroupId === 0 || codeGroupId === from);
            var msg = recode
                ? codeWillChange.replace('{0}', curCode).replace('{1}', to.attr('data-next'))
                : codeStays.replace('{0}', curCode);
            $('#trPreview').show().text(msg);
        }
        $('#trTo, #trFrom').on('change', preview);

        function doTransfer() {
            if (!$('#trTo').val()) { notify('warning', pickNewGroup); return; }

            askConfirm(transferAsk, transferYes).then(function (ok) {
                if (!ok) return;
                postJson('@Url.Action("Transfer", "Students")', $('#trForm').serialize(), function (r) {
                    var safe = $('<div>').text(r.message).html();
                    swalShow({
                        icon: 'success', title: transferred, confirmButtonText: okText,
                        html: '<div style="line-height:1.9">' + safe + '</div>' +
                            '<a class="btn btn-primary mt-3" target="_blank" href="@Url.Action("Card", "Students")/' + r.id + '">' + printStudentCard + '</a>'
                    }).then(function () { location.reload(); });
                });
            });
        }
    </script>
}
