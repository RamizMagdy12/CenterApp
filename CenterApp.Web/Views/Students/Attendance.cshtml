@model StudentAttendanceVm
@{
    ViewData["Title"] = L.Get("Students.AttendanceOf", Model.StudentName).Value;
}
<a class="btn btn-sm btn-light mb-3" asp-action="Index"><i class="bi @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "bi-arrow-right" : "bi-arrow-left")"></i> @L.Get("Menu.Students")</a>
<h3 class="mb-3">@Model.StudentName <small class="text-muted" dir="ltr">@Model.StudentCode</small></h3>
<partial name="_StudentAttendance" model="Model" />
