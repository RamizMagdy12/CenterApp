@model PagedResult<Student>
@inject CenterApp.Application.Abstractions.IPermissionService Perm
@{
    ViewData["Title"] = L.Get("Menu.Students").Value;
    var grades = (List<SelectListItem>)ViewBag.Grades;
    var gid = (ViewBag.GradeId as long?)?.ToString() ?? "";
    var q = (string?)ViewBag.Q;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@L.Get("Menu.Students") <span class="badge bg-secondary">@Model.Total</span></h3>
    <button class="btn btn-primary" onclick="openForm('@Url.Action("Form", "Students")', '@L.Get("Students.New")', true)">+ @L.Get("Students.New")</button>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="q" value="@q" class="form-control" placeholder="@L.Get("Students.Search")" /></div>
    <div class="col-md-3">
        <select name="gradeId" class="form-select">
            <option value="">@L.Get("Students.AllGrades")</option>
            @foreach (var g in grades)
            {
                <option value="@g.Value" selected="@(g.Value == gid)">@g.Text</option>
            }
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-outline-primary">@L.Get("Common.Search")</button></div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead><tr><th>@L.Get("Common.Code")</th><th>@L.Get("Common.Name")</th><th>@L.Get("Common.Phone")</th><th>@L.Get("Students.Parent")</th><th>@L.Get("Common.Grade")</th><th>@L.Get("Common.Status")</th><th></th></tr></thead>
    <tbody>
        @foreach (var s in Model.Items)
        {
            <tr>
                <td>@s.Code</td>
                <td>@s.Name</td>
                <td>@s.Phone</td>
                <td>@s.ParentName <small class="text-muted">@s.ParentPhone</small></td>
                <td>@s.GradeLevel?.Name</td>
                <td>@if (s.IsActive) {
                    <span class="badge bg-success">@L.Get("Common.Active")</span>
                } else
                {

                    <span class="badge bg-secondary">@L.Get("Common.Stopped")</span>
                }
            </td>
            <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-success" asp-action="Attendance" asp-route-id="@s.Id">@L.Get("Menu.Attendance")</a>
                <button class="btn btn-sm btn-outline-primary" onclick="openForm('@Url.Action("Form", "Students", new { id = s.Id })', '@L.Get("Students.Edit")', true)">@L.Get("Common.Edit")</button>
                    <a class="btn btn-sm btn-outline-dark" target="_blank" href="@Url.Action("Card", "Students", new { id = s.Id })">@L.Get("Students.QrCard")</a>
                    <button class="btn btn-sm btn-outline-success" onclick="studentAccount(@s.Id)">@L.Get("Students.LoginAccount")</button>
                <button class="btn btn-sm btn-outline-danger" onclick="confirmPost('@Url.Action("Delete", "Students")', { id: @s.Id }, '@L.Get("Common.ConfirmDelete")')">@L.Get("Common.Delete")</button>
            </td>
        </tr>
    }
</tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-q="@q" asp-route-gradeId="@gid" asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
@section Scripts {
    <script>
        function studentAccount(id) {
            askConfirm(@Json.Serialize(L.Get("Students.AccountAsk").Value), @Json.Serialize(L.Get("Common.Yes").Value)).then(function (ok) {
                if (!ok) return;
                postJson('@Url.Action("Account", "Students")', { id: id }, function (r) {
                    var p = (r.extra || '').split('|');
                    swalShow({
                        icon: 'success', title: @Json.Serialize(L.Get("Students.Credentials").Value),
                        html: '<div style="font-size:18px;line-height:2">' + @Json.Serialize(L.Get("Users.UserName").Value) + ': <b dir="ltr">' + p[0] + '</b><br>' + @Json.Serialize(L.Get("Auth.Password").Value) + ': <b dir="ltr">' + p[1] + '</b></div>' +
                            '<small class="text-muted">' + @Json.Serialize(L.Get("Students.CredentialsHint").Value) + '</small>'
                    });
                });
            });
        }
    </script>
}