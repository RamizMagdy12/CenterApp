@model StudentVm
@inject CenterApp.Service.Services.IPermissionService Perm
@functions {
    static string Label(GroupPick p)
    {
        var s = p.Name;
        if (p.Code.Length > 0) s += $" ({p.Code})";
        if (p.Free >= 0) s += $" — متبقي {p.Free}";
        if (p.Why != null) s += $" — {p.Why}";
        return s;
    }
}
@{
    var grades = (List<SelectListItem>)ViewBag.Grades;
    var picks = (List<GroupPick>)ViewBag.Picks;
    var isNew = Model.Id == 0;
}
<form id="studentForm" onsubmit="return false;">
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">الاسم</label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">كود الطالب</label>
            <input id="codeView" class="form-control" dir="ltr" disabled value="@(isNew ? "يتولّد حسب المجموعة" : Model.Code)" />
        </div>
        <div class="col-md-3">
            <label class="form-label">المرحلة</label>
            <select asp-for="GradeLevelId" asp-items="grades" class="form-select"><option value="">-- اختر --</option></select>
        </div>

        @if (isNew)
        {
            <div class="col-md-6">
                <label class="form-label">المجموعة <span class="text-danger">*</span></label>
                <select name="GroupId" id="sGroup" class="form-select">
                    <option value="">-- اختر المجموعة --</option>
                    @foreach (var p in picks)
                    {
                        <option value="@p.Id" data-next="@p.NextCode" disabled="@p.Disabled">@Label(p)</option>
                    }
                </select>
                <small class="text-muted">الطالب مينفعش يتسجّل من غير مجموعة، وكوده بيتحدد حسب كودها.</small>
            </div>
        }
        else
        {
            <div class="col-12">
                <label class="form-label">المجموعة الحالية</label>
                <div>
                    @if (Model.GroupNames.Count == 0)
                    {
                        <span class="text-muted">مش مسجل في أي مجموعة</span>
                    }
                    @foreach (var n in Model.GroupNames)
                    {
                        <span class="badge bg-primary me-1">@n</span>
                    }
                    @if (Model.GroupNames.Count > 0 && Perm.Has(User, Screens.Groups, PermissionAction.Edit))
                    {
                        <button type="button" class="btn btn-sm btn-outline-dark ms-2"
                                onclick="openForm('@Url.Action("TransferForm", "Students", new { id = Model.Id })', 'نقل طالب', true)">
                            نقل لمجموعة تانية
                        </button>
                    }
                </div>
                <small class="text-muted">الطالب يفضل في مجموعة واحدة. عشان تغيّرها استخدم نقل.</small>
            </div>
        }

        <div class="col-md-4"><label class="form-label">موبايل الطالب</label><input asp-for="Phone" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">اسم ولي الأمر</label><input asp-for="ParentName" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">موبايل ولي الأمر</label><input asp-for="ParentPhone" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">تاريخ الميلاد</label><input asp-for="BirthDate" type="date" class="form-control" /></div>
        <div class="col-md-8"><label class="form-label">ملاحظات</label><input asp-for="Notes" class="form-control" /></div>

        <div class="col-12 form-check ms-3">
            <input asp-for="IsActive" class="form-check-input" /><label class="form-check-label">نشط</label>
        </div>
        <div class="col-12"><button class="btn btn-success" onclick="saveStudent()">حفظ</button></div>
    </div>
</form>

<script>
    var qrUrl = '@Url.Action("Qr", "Students")';
    var cardUrl = '@Url.Action("Card", "Students")';

    $('#sGroup').on('change', function () {
        var next = $(this).find('option:selected').attr('data-next');
        $('#codeView').val(next ? next : 'يتولّد حسب المجموعة');
    });

    function saveStudent() {
        var isNew = $('#studentForm input[name=Id]').val() === '0';
        if (isNew && !$('#sGroup').val()) { notify('warning', 'اختار المجموعة، الطالب مينفعش يتسجّل من غير مجموعة'); return; }

        postJson('@Url.Action("Save", "Students")', $('#studentForm').serialize(), function (r) {
            if (!isNew) { appModal().hide(); location.reload(); return; }

            var p = (r.extra || '').split('|');   // [الكود، توكن الـ QR]
            var html =
                '<div class="text-center">' +
                '<div class="alert alert-success">' + r.message + '</div>' +
                '<img src="' + qrUrl + '?code=' + encodeURIComponent(p[1]) + '" width="180" alt="QR" />' +
                '<div class="fw-bold fs-4 my-2" dir="ltr">' + p[0] + '</div>' +
                '<a class="btn btn-primary" target="_blank" href="' + cardUrl + '/' + r.id + '">طباعة الكارت</a> ' +
                '<button class="btn btn-secondary" onclick="location.reload()">إغلاق</button>' +
                '</div>';
            $('#appModalBody').html(html);
            $('#appModal').off('hidden.bs.modal.stu').one('hidden.bs.modal.stu', function () { location.reload(); });
        });
    }
</script>