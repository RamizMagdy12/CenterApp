@model List<StudentCardVm>
@{
    Layout = null;
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<!DOCTYPE html>
<html lang="@(isAr ? "ar" : "en")" dir="@(isAr ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <title>@L.Get("Students.CardsTitle")</title>
    <style>
            body {
                font-family: Tahoma, Arial, sans-serif;
                margin: 0;
                padding: 16px;
            }

            .toolbar {
                margin-bottom: 16px;
            }

                .toolbar button {
                    padding: 8px 20px;
                    font-size: 16px;
                    cursor: pointer;
                }

            .cards {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
            }

            .id-card {
                width: 12cm;
                height: 7.6cm;
                border: 1.5px solid #163044;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: space-around;
                padding: 12px;
                box-sizing: border-box;
                page-break-inside: avoid;
            }

                .id-card img {
                    width: 5.8cm;
                    height: 5.8cm;
                }

            .info {
                text-align: center;
                max-width: 5.2cm;
            }

                .info .nm {
                    font-weight: bold;
                    font-size: 20px;
                    line-height: 1.35;
                    word-break: break-word;
                }

                .info .cd {
                    margin-top: 10px;
                    font-size: 22px;
                    font-weight: bold;
                    letter-spacing: 1px;
                    direction: ltr;
                }

            @@media screen and (max-width: 420px) {
                .id-card {
                    width: 100%;
                    height: auto;
                    min-height: 7.6cm;
                }
            }

            @@media print {
                .toolbar {
                    display: none;
                }

                body {
                    padding: 0;
                }
            }
    </style>
</head>
<body>
    <div class="toolbar"><button onclick="window.print()">@L.Get("Students.Print")</button></div>
    @if (Model.Count == 0)
    {
        <p>@L.Get("Students.NoStudents")</p>
    }
    <div class="cards">
        @foreach (var s in Model)
        {
            <div class="id-card">
                <img src="@Url.Action("Qr", "Students", new { code = s.QrToken })" alt="QR" />
                <div class="info">
                    <div class="nm">@s.Name</div>
                    <div class="cd">@s.Code</div>
                </div>
            </div>
        }
    </div>
</body>
</html>
