@model List<HomeworkRow>
@inject CenterApp.Service.Services.IPermissionService Perm
@{
    ViewData["Title"] = "الواجبات";
    var canAdd = Perm.Has(User, Screens.Homework, PermissionAction.Add);
    var canEdit = Perm.Has(User, Screens.Homework, PermissionAction.Edit);
    var canDelete = Perm.Has(User, Screens.Homework, PermissionAction.Delete);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>الواجبات <span class="badge bg-secondary">@Model.Count</span></h3>
    @if (canAdd)
    {
        <a class="btn btn-primary" asp-action="Edit">+ واجب جديد</a>
    }
</div>

<table class="table table-striped table-hover align-middle">
    <thead><tr><th>العنوان</th><th>المدرس</th><th>المجموعات</th><th>الملفات</th><th>الحالة</th><th>تاريخ النشر</th><th></th></tr></thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td><strong>@m.Title</strong></td>
                <td>@m.Teacher</td>
                <td><small>@m.Groups</small></td>
                <td><span class="badge bg-primary">@m.FilesCount</span></td>
                <td>
                    @if (m.Status == HomeworkStatus.Published)
                    {
                        <span class="badge bg-success">منشور</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">مسودة</span>
                    }
                </td>
                <td>@m.PublishedAt?.ToString("yyyy-MM-dd")</td>
                <td class="text-nowrap">
                    @if (canEdit)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@m.Id">تعديل</a>
                    }
                    @if (canDelete)
                    {
                        <button class="btn btn-sm btn-outline-danger" onclick="confirmPost('@Url.Action("Delete", "Homeworks")', { id: @m.Id }, 'حذف الواجب وكل ملفاته؟')">حذف</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
