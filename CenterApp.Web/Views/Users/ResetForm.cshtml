@model UserVm
<form id="resetForm" onsubmit="return false;" autocomplete="off">
    <input type="hidden" name="id" value="@Model.Id" />
    <p>@L.Get("Users.UserLabel"): <strong>@Model.UserName</strong> @Model.FullName</p>
    <div class="mb-3">
        <label class="form-label">@L.Get("Users.NewPassword")</label>
        <input name="password" type="password" class="form-control" autocomplete="new-password" />
    </div>
    <button class="btn btn-success" onclick="submitForm('#resetForm', '@Url.Action("ResetPassword", "Users")', function (r) { appModal().hide(); notify('success', r.message); })">@L.Get("Common.Save")</button>
</form>