@model List<UserRow>
@inject CenterApp.Service.Services.IPermissionService Perm
@{
    ViewData["Title"] = L.Get("Menu.Users").Value;
    var canAdd = Perm.Has(User, Screens.Users, PermissionAction.Add);
    var canEdit = Perm.Has(User, Screens.Users, PermissionAction.Edit);
    var canDelete = Perm.Has(User, Screens.Users, PermissionAction.Delete);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@L.Get("Menu.Users") <span class="badge bg-secondary">@Model.Count</span></h3>
    @if (canAdd)
    {
        <button class="btn btn-primary" onclick="openForm('@Url.Action("Form", "Users")', '@L.Get("Users.New")', true)">+ @L.Get("Users.New")</button>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="@L.Get("Users.Search")" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary">@L.Get("Common.Search")</button></div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead><tr><th>@L.Get("Users.UserName")</th><th>@L.Get("Common.Name")</th><th>@L.Get("Users.Role")</th><th>@L.Get("Users.EmailPhone")</th><th>@L.Get("Common.Status")</th><th></th></tr></thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td><strong>@u.UserName</strong></td>
                <td>@u.FullName</td>
                <td><span class="badge @(u.IsAdmin ? "bg-danger" : "bg-primary")">@u.Role</span></td>
                <td>@u.Email <small class="text-muted">@u.Phone</small></td>
                <td>@if (u.IsActive) {
                    <span class="badge bg-success">@L.Get("Common.Active")</span>
                } else
                {

                    <span class="badge bg-secondary">@L.Get("Common.Stopped")</span>
                }
            </td>
            <td class="text-nowrap">
                @if (canEdit)
                {
                    <button class="btn btn-sm btn-outline-primary" onclick="openForm('@Url.Action("Form", "Users", new { id = u.Id })', '@L.Get("Users.Edit")', true)">@L.Get("Common.Edit")</button>
                    <button class="btn btn-sm btn-outline-dark" onclick="openForm('@Url.Action("ResetForm", "Users", new { id = u.Id })', '@L.Get("Users.ChangePassword")')">@L.Get("Auth.Password")</button>
                }
                @if (canDelete)
                {
                    <button class="btn btn-sm btn-outline-danger" onclick="confirmPost('@Url.Action("Delete", "Users")', { id: '@u.Id' }, '@L.Get("Users.DeleteAsk", u.UserName)')">@L.Get("Common.Delete")</button>
                }
            </td>
        </tr>
    }
</tbody>
</table>