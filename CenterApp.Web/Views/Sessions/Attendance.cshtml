@model AttendanceVm

<div class="mb-3 d-flex flex-wrap align-items-center gap-2">
    <strong>@Model.GroupName</strong> — @ArabicDays.Name(Model.Date.DayOfWeek) @Model.Date.ToString("yyyy-MM-dd")
    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="$('.att-present').prop('checked', true); updateCounter();">@L.Get("Sessions.AllPresent")</button>
    <button type="button" class="btn btn-sm btn-dark" onclick="startQrMode()">@L.Get("Sessions.QrMode")</button>
    <span class="badge bg-info text-dark" id="attCounter"></span>
</div>

<div id="qrPanel" class="border rounded p-3 mb-3" style="display:none">
    <div class="row g-2 align-items-center">
        <div class="col-md-5">
            <input id="qrInput" class="form-control" autocomplete="off" placeholder="@L.Get("Sessions.ScanPh")" />
        </div>
        <div class="col-md-3"><button type="button" class="btn btn-outline-primary w-100" onclick="startCam()">@L.Get("Sessions.StartCamera")</button></div>
        <div class="col-md-2"><button type="button" class="btn btn-outline-secondary w-100" onclick="stopCam()">@L.Get("Sessions.Stop")</button></div>
        <div class="col-md-2"><button type="button" class="btn btn-outline-danger w-100" onclick="resetAllAbsent()">@L.Get("Sessions.ResetAll")</button></div>
    </div>
    <div id="camBox" class="mt-3" style="display:none"><div id="qrReader" style="max-width:360px"></div></div>
    <div id="scanMsg" class="mt-2 fw-bold"></div>
    <small class="text-muted">@L.Get("Sessions.QrHint")</small>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="alert alert-warning">@L.Get("Sessions.NoStudentsDay")</div>
}
else
{
    <table class="table table-sm align-middle">
        <thead><tr><th>@L.Get("Common.Code")</th><th>@L.Get("Common.Student")</th><th>@L.Get("Att.Present")</th><th>@L.Get("Att.Absent")</th><th>@L.Get("Sessions.Excused")</th><th>@L.Get("Att.Late")</th></tr></thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr class="att-row" data-student="@r.StudentId" data-code="@r.StudentCode" data-token="@r.QrToken" data-recorded="@(r.IsRecorded ? "1" : "0")">
                    <td class="text-muted">@r.StudentCode</td>
                    <td>@r.StudentName</td>
                    <td><input type="radio" class="att-present" name="st_@r.StudentId" value="0" @(r.Status == AttendanceStatus.Present ? "checked" : "") /></td>
                    <td><input type="radio" name="st_@r.StudentId" value="1" @(r.Status == AttendanceStatus.Absent ? "checked" : "") /></td>
                    <td><input type="radio" name="st_@r.StudentId" value="2" @(r.Status == AttendanceStatus.Excused ? "checked" : "") /></td>
                    <td><input type="radio" name="st_@r.StudentId" value="3" @(r.Status == AttendanceStatus.Late ? "checked" : "") /></td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-success" onclick="saveAttendance()">@L.Get("Sessions.SaveAttendance")</button>
}

<script>
    var qrScanner = null, lastCode = '', lastTime = 0;
    var attCountTpl = @Json.Serialize(L.Get("Sessions.AttendedOf").Value);
    var readyScan = @Json.Serialize(L.Get("Sessions.ReadyScan").Value);
    var resetAsk = @Json.Serialize(L.Get("Sessions.ResetAsk").Value);
    var resetYes = @Json.Serialize(L.Get("Sessions.ResetYes").Value);
    var resetDone = @Json.Serialize(L.Get("Sessions.ResetDone").Value);
    var unknownCode = @Json.Serialize(L.Get("Sessions.UnknownCode").Value);
    var alreadyMarked = @Json.Serialize(L.Get("Sessions.AlreadyMarked").Value);
    var markedPresent = @Json.Serialize(L.Get("Sessions.Marked").Value);
    var cameraError = @Json.Serialize(L.Get("Sessions.CameraError").Value);
    var cameraLibError = @Json.Serialize(L.Get("Sessions.CameraLibError").Value);

    function norm(c) { return (c || '').toString().trim().toUpperCase(); }

    function beep(ok) {
        try {
            var ctx = new (window.AudioContext || window.webkitAudioContext)();
            var o = ctx.createOscillator();
            o.frequency.value = ok ? 880 : 220;
            o.connect(ctx.destination);
            o.start();
            setTimeout(function () { o.stop(); ctx.close(); }, ok ? 120 : 300);
        } catch (e) { }
    }

    function showMsg(text, ok) {
        $('#scanMsg').text(text).removeClass('text-success text-danger').addClass(ok ? 'text-success' : 'text-danger');
    }

    function currentStatus($row) {
        var sid = $row.data('student');
        return $row.find('input[name=st_' + sid + ']:checked').val();
    }

    function updateCounter() {
        var total = $('.att-row').length;
        var present = $('.att-row input[value="0"]:checked, .att-row input[value="3"]:checked').length;
        $('#attCounter').text(attCountTpl.replace('{0}', present).replace('{1}', total));
    }

    // وضع الـ QR: المسجّل قبل كده يفضل زي ما هو، وغير المسجّل يبدأ غائب
    function startQrMode() {
        $('.att-row').each(function () {
            var $r = $(this), sid = $r.data('student');
            $r.removeClass('table-success scanned');

            if ($r.attr('data-recorded') === '1') {
                var st = currentStatus($r);
                if (st === '0' || st === '3') $r.addClass('table-success scanned');   // حاضر قبل كده
            } else {
                $r.find('input[name=st_' + sid + '][value="1"]').prop('checked', true);
            }
        });
        $('#qrPanel').show();
        updateCounter();
        showMsg(readyScan, true);
        $('#qrInput').focus();
    }

    function resetAllAbsent() {
        askConfirm(resetAsk, resetYes).then(function (ok) {
            if (!ok) return;
            $('.att-row').removeClass('table-success scanned');
            $('.att-row input[value="1"]').prop('checked', true);
            updateCounter();
            showMsg(resetDone, true);
            $('#qrInput').focus();
        });
    }

    function markByCode(raw) {
        var code = norm(raw);
        if (!code) return;

        var $row = $('.att-row').filter(function () {
            return norm($(this).attr('data-code')) === code || norm($(this).attr('data-token')) === code;
        }); if ($row.length === 0) {
            beep(false);
            showMsg(unknownCode.replace('{0}', code), false);
            return;
        }

        var sid = $row.data('student');
        var name = $row.find('td').eq(1).text();

        if ($row.hasClass('scanned')) {
            beep(true);
            showMsg(alreadyMarked.replace('{0}', name), true);
            return;
        }

        $row.find('input[name=st_' + sid + '][value="0"]').prop('checked', true);
        $row.addClass('table-success scanned');
        if ($row[0].scrollIntoView) $row[0].scrollIntoView({ block: 'nearest' });
        beep(true);
        showMsg(markedPresent.replace('{0}', name), true);
        updateCounter();
    }

    // قارئ الباركود (بيكتب الكود ويدوس Enter)
    $('#qrInput').on('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            markByCode($(this).val());
            $(this).val('').focus();
        }
    });

    // الكاميرا
    function startCam() {
        function run() {
            $('#camBox').show();
            qrScanner = new Html5Qrcode('qrReader');
            qrScanner.start({ facingMode: 'environment' }, { fps: 10, qrbox: 250 }, function (text) {
                var now = Date.now();
                if (text === lastCode && now - lastTime < 2500) return;
                lastCode = text; lastTime = now;
                markByCode(text);
            }).catch(function (err) {
                $('#camBox').hide();
                qrScanner = null;
                notify('error', cameraError);
            });
        }
        if (qrScanner) return;
        if (typeof Html5Qrcode === 'undefined') {
            $.getScript('@Url.Content("~/lib/html5-qrcode/html5-qrcode.min.js")', run)
                .fail(function () { notify('error', cameraLibError); });
        } else run();
    }

    function stopCam() {
        if (qrScanner) {
            var sc = qrScanner; qrScanner = null;
            sc.stop().then(function () { sc.clear(); }).catch(function () { });
        }
        $('#camBox').hide();
    }

    $('#appModal').off('hidden.bs.modal.cam').one('hidden.bs.modal.cam', stopCam);
    $('#appModal').off('shown.bs.modal.att').one('shown.bs.modal.att', function () {
        if ($('#qrPanel').is(':visible')) $('#qrInput').focus();
    });

    $(document).off('change.att').on('change.att', '.att-row input', updateCounter);
    updateCounter();

    function saveAttendance() {
        var rows = $('.att-row').map(function () {
            var sid = $(this).data('student');
            return { StudentId: sid, Status: parseInt($(this).find('input[name=st_' + sid + ']:checked').val()) };
        }).get();
        stopCam();
        postBody('@Url.Action("SaveAttendance", "Sessions")', { SessionId: @Model.SessionId, Rows: rows });
    }
</script>
