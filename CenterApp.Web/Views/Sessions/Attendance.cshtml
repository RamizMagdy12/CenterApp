@model AttendanceVm

<style>
    .att-sheet { display: flex; flex-direction: column; gap: 12px; }
    .att-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 10px; }
    .att-meta strong { font-size: 1.02rem; }
    .att-meta .att-date { color: var(--muted); font-size: 13px; }
    .att-tools { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .att-search { position: relative; flex: 1 1 220px; }
    .att-search .bi-search { position: absolute; top: 50%; transform: translateY(-50%); inset-inline-start: 12px; color: var(--muted); pointer-events: none; }
    .att-search input { padding-inline-start: 34px; border-radius: 10px; }
    .att-count { font-weight: 700; }
    .att-list { display: flex; flex-direction: column; gap: 8px; max-height: min(52vh, 520px); overflow: auto; }
    .att-row {
        display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px;
        border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; background: #fff;
    }
    .att-row.scanned { border-color: #1c8a52; background: #f3fbf6; }
    .att-who { flex: 1 1 160px; min-width: 0; }
    .att-code {
        display: inline-block; font-size: 12px; font-weight: 800; color: var(--primary);
        background: var(--primary-soft); border-radius: 6px; padding: 1px 7px; margin-inline-end: 6px;
    }
    .att-name { font-weight: 700; }
    .att-seg { display: flex; flex-wrap: wrap; gap: 4px; }
    .att-opt { margin: 0; }
    .att-opt input { position: absolute; opacity: 0; width: 1px; height: 1px; }
    .att-opt span {
        display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 999px;
        padding: 5px 12px; font-size: 13px; font-weight: 700; cursor: pointer; color: var(--muted); background: #fff;
    }
    .att-opt input:focus-visible + span { outline: 2px solid var(--primary); outline-offset: 1px; }
    .att-opt input:checked + span { color: #fff; border-color: transparent; }
    .att-opt.present input:checked + span { background: #1c8a52; }
    .att-opt.absent input:checked + span { background: #c0392b; }
    .att-opt.excused input:checked + span { background: #5d7a8c; }
    .att-opt.late input:checked + span { background: #b8860b; }
    .att-foot { display: flex; justify-content: flex-end; }
    #qrPanel { border-radius: 12px; background: #f7fbfc; }
</style>

<div class="att-sheet">
    <div class="att-meta">
        <strong>@Model.GroupName</strong>
        <span class="att-date">@ArabicDays.Name(Model.Date.DayOfWeek) · @Model.Date.ToString("yyyy-MM-dd")</span>
    </div>

    @if (Model.Rows.Count == 0)
    {
        <div class="alert alert-warning mb-0">@L.Get("Sessions.NoStudentsDay")</div>
    }
    else
    {
        <div class="att-tools">
            <div class="att-search">
                <i class="bi bi-search"></i>
                <input id="attSearch" class="form-control" autocomplete="off" placeholder="@L.Get("Sessions.SearchPh")" />
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="$('.att-present').prop('checked', true); updateCounter();">@L.Get("Sessions.AllPresent")</button>
            <button type="button" class="btn btn-sm btn-dark" onclick="startQrMode()">@L.Get("Sessions.QrMode")</button>
            <span class="badge bg-info text-dark att-count" id="attCounter"></span>
        </div>

        <div id="qrPanel" class="border rounded p-3" style="display:none">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <input id="qrInput" class="form-control" autocomplete="off" placeholder="@L.Get("Sessions.ScanPh")" />
                </div>
                <div class="col-md-3"><button type="button" class="btn btn-outline-primary w-100" onclick="startCam()">@L.Get("Sessions.StartCamera")</button></div>
                <div class="col-md-2"><button type="button" class="btn btn-outline-secondary w-100" onclick="stopCam()">@L.Get("Sessions.Stop")</button></div>
                <div class="col-md-2"><button type="button" class="btn btn-outline-danger w-100" onclick="resetAllAbsent()">@L.Get("Sessions.ResetAll")</button></div>
            </div>
            <div id="camBox" class="mt-3" style="display:none"><div id="qrReader" style="max-width:360px"></div></div>
            <div id="scanMsg" class="mt-2 fw-bold"></div>
            <small class="text-muted">@L.Get("Sessions.QrHint")</small>
        </div>

        <div class="att-list">
            @foreach (var r in Model.Rows)
            {
                <div class="att-row" data-student="@r.StudentId" data-code="@r.StudentCode" data-name="@r.StudentName" data-token="@r.QrToken" data-recorded="@(r.IsRecorded ? "1" : "0")">
                    <div class="att-who">
                        <span class="att-code">@r.StudentCode</span>
                        <span class="att-name">@r.StudentName</span>
                    </div>
                    <div class="att-seg">
                        <label class="att-opt present"><input type="radio" class="att-present" name="st_@r.StudentId" value="0" @(r.Status == AttendanceStatus.Present ? "checked" : "") /><span>@L.Get("Att.Present")</span></label>
                        <label class="att-opt absent"><input type="radio" name="st_@r.StudentId" value="1" @(r.Status == AttendanceStatus.Absent ? "checked" : "") /><span>@L.Get("Att.Absent")</span></label>
                        <label class="att-opt excused"><input type="radio" name="st_@r.StudentId" value="2" @(r.Status == AttendanceStatus.Excused ? "checked" : "") /><span>@L.Get("Sessions.Excused")</span></label>
                        <label class="att-opt late"><input type="radio" name="st_@r.StudentId" value="3" @(r.Status == AttendanceStatus.Late ? "checked" : "") /><span>@L.Get("Att.Late")</span></label>
                    </div>
                </div>
            }
        </div>
        <div class="alert alert-light border mb-0" id="attNoMatch" style="display:none">@L.Get("Sessions.NoSearchMatch")</div>
        <div class="att-foot">
            <button class="btn btn-success" onclick="saveAttendance()">@L.Get("Sessions.SaveAttendance")</button>
        </div>
    }
</div>

<script>
    var qrScanner = null, lastCode = '', lastTime = 0;
    var attCountTpl = @Json.Serialize(L.Get("Sessions.AttendedOf").Value);
    var readyScan = @Json.Serialize(L.Get("Sessions.ReadyScan").Value);
    var resetAsk = @Json.Serialize(L.Get("Sessions.ResetAsk").Value);
    var resetYes = @Json.Serialize(L.Get("Sessions.ResetYes").Value);
    var resetDone = @Json.Serialize(L.Get("Sessions.ResetDone").Value);
    var unknownCode = @Json.Serialize(L.Get("Sessions.UnknownCode").Value);
    var alreadyMarked = @Json.Serialize(L.Get("Sessions.AlreadyMarked").Value);
    var markedPresent = @Json.Serialize(L.Get("Sessions.Marked").Value);
    var cameraError = @Json.Serialize(L.Get("Sessions.CameraError").Value);
    var cameraLibError = @Json.Serialize(L.Get("Sessions.CameraLibError").Value);

    $('#appModalDialog').addClass('modal-xl');

    function norm(c) { return (c || '').toString().trim().toUpperCase(); }

    function beep(ok) {
        try {
            var ctx = new (window.AudioContext || window.webkitAudioContext)();
            var o = ctx.createOscillator();
            o.frequency.value = ok ? 880 : 220;
            o.connect(ctx.destination);
            o.start();
            setTimeout(function () { o.stop(); ctx.close(); }, ok ? 120 : 300);
        } catch (e) { }
    }

    function showMsg(text, ok) {
        $('#scanMsg').text(text).removeClass('text-success text-danger').addClass(ok ? 'text-success' : 'text-danger');
    }

    function currentStatus($row) {
        var sid = $row.data('student');
        return $row.find('input[name=st_' + sid + ']:checked').val();
    }

    function updateCounter() {
        var total = $('.att-row').length;
        var present = $('.att-row input[value="0"]:checked, .att-row input[value="3"]:checked').length;
        $('#attCounter').text(attCountTpl.replace('{0}', present).replace('{1}', total));
    }

    function filterRows() {
        var q = norm($('#attSearch').val());
        var shown = 0;
        $('.att-row').each(function () {
            var code = norm($(this).attr('data-code'));
            var name = norm($(this).attr('data-name'));
            var match = !q || code.indexOf(q) >= 0 || name.indexOf(q) >= 0;
            $(this).toggle(match);
            if (match) shown++;
        });
        $('#attNoMatch').toggle(!!q && shown === 0);
    }

    function startQrMode() {
        $('.att-row').each(function () {
            var $r = $(this), sid = $r.data('student');
            $r.removeClass('scanned');

            if ($r.attr('data-recorded') === '1') {
                var st = currentStatus($r);
                if (st === '0' || st === '3') $r.addClass('scanned');
            } else {
                $r.find('input[name=st_' + sid + '][value="1"]').prop('checked', true);
            }
        });
        $('#qrPanel').show();
        updateCounter();
        showMsg(readyScan, true);
        $('#qrInput').focus();
    }

    function resetAllAbsent() {
        askConfirm(resetAsk, resetYes).then(function (ok) {
            if (!ok) return;
            $('.att-row').removeClass('scanned');
            $('.att-row input[value="1"]').prop('checked', true);
            updateCounter();
            showMsg(resetDone, true);
            $('#qrInput').focus();
        });
    }

    function markByCode(raw) {
        var code = norm(raw);
        if (!code) return;

        var $row = $('.att-row').filter(function () {
            return norm($(this).attr('data-code')) === code || norm($(this).attr('data-token')) === code;
        });
        if ($row.length === 0) {
            beep(false);
            showMsg(unknownCode.replace('{0}', code), false);
            return;
        }

        var sid = $row.data('student');
        var name = $row.attr('data-name') || '';

        if ($row.hasClass('scanned')) {
            beep(true);
            showMsg(alreadyMarked.replace('{0}', name), true);
            return;
        }

        $row.find('input[name=st_' + sid + '][value="0"]').prop('checked', true);
        $row.addClass('scanned').show();
        if ($row[0].scrollIntoView) $row[0].scrollIntoView({ block: 'nearest' });
        beep(true);
        showMsg(markedPresent.replace('{0}', name), true);
        updateCounter();
    }

    $('#qrInput').on('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            markByCode($(this).val());
            $(this).val('').focus();
        }
    });

    $('#attSearch').on('input', filterRows);

    function startCam() {
        function run() {
            $('#camBox').show();
            qrScanner = new Html5Qrcode('qrReader');
            qrScanner.start({ facingMode: 'environment' }, { fps: 10, qrbox: 250 }, function (text) {
                var now = Date.now();
                if (text === lastCode && now - lastTime < 2500) return;
                lastCode = text; lastTime = now;
                markByCode(text);
            }).catch(function () {
                $('#camBox').hide();
                qrScanner = null;
                notify('error', cameraError);
            });
        }
        if (qrScanner) return;
        if (typeof Html5Qrcode === 'undefined') {
            $.getScript('@Url.Content("~/lib/html5-qrcode/html5-qrcode.min.js")', run)
                .fail(function () { notify('error', cameraLibError); });
        } else run();
    }

    function stopCam() {
        if (qrScanner) {
            var sc = qrScanner; qrScanner = null;
            sc.stop().then(function () { sc.clear(); }).catch(function () { });
        }
        $('#camBox').hide();
    }

    $('#appModal').off('hidden.bs.modal.cam').one('hidden.bs.modal.cam', function () {
        stopCam();
        $('#appModalDialog').removeClass('modal-xl');
    });
    $('#appModal').off('shown.bs.modal.att').one('shown.bs.modal.att', function () {
        if ($('#qrPanel').is(':visible')) $('#qrInput').focus();
    });

    $(document).off('change.att').on('change.att', '.att-row input', updateCounter);
    updateCounter();

    function saveAttendance() {
        var rows = $('.att-row').map(function () {
            var sid = $(this).data('student');
            return { StudentId: sid, Status: parseInt($(this).find('input[name=st_' + sid + ']:checked').val()) };
        }).get();
        stopCam();
        postBody('@Url.Action("SaveAttendance", "Sessions")', { SessionId: @Model.SessionId, Rows: rows });
    }
</script>
