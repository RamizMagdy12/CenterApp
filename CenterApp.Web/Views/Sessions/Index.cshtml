@model List<SessionRow>
@{
    ViewData["Title"] = L.Get("Sessions.Title").Value;
    var groups = (List<SelectListItem>)ViewBag.Groups;
    var gid = ((long)ViewBag.GroupId).ToString();
}

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-4">
        <label class="form-label">@L.Get("Common.Group")</label>
        <select id="groupId" name="groupId" class="form-select">
            <option value="0">@L.Get("Common.AllGroups")</option>
            @foreach (var g in groups)
            {
                <option value="@g.Value" selected="@(g.Value == gid)">@g.Text</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">@L.Get("Sessions.Month")</label>
        <input type="month" id="month" name="month" value="@ViewBag.Month" class="form-control" />
    </div>
    <div class="col-auto"><button class="btn btn-outline-primary">@L.Get("Sessions.Show")</button></div>
    <div class="col-auto"><button type="button" class="btn btn-primary" onclick="generateSessions()">@L.Get("Sessions.GenerateMonth")</button></div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead><tr><th>@L.Get("Sessions.Date")</th><th>@L.Get("Sessions.Day")</th><th>@L.Get("Common.Group")</th><th>@L.Get("Sessions.From")</th><th>@L.Get("Sessions.To")</th><th>@L.Get("Common.Status")</th><th>@L.Get("Sessions.PresentAbsent")</th><th></th></tr></thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr class="@(r.Status == SessionStatus.Cancelled ? "table-secondary text-decoration-line-through" : "")">
                <td>@r.Date.ToString("yyyy-MM-dd")</td>
                <td>@ArabicDays.Name(r.Date.DayOfWeek)</td>
                <td>@r.GroupName</td>
                <td>@r.Start.ToString(@"hh\:mm")</td>
                <td>@r.End.ToString(@"hh\:mm")</td>
                <td>
                    @if (r.Status == SessionStatus.Done)
                    {
                        <span class="badge bg-success">@L.Get("Sessions.Done")</span>
                    }
                    else if (r.Status == SessionStatus.Cancelled)
                    {

                        <span class="badge bg-secondary">@L.Get("Sessions.Cancelled")</span>
                    }
                    else if (r.CanTakeAttendance)
                    {

                        <span class="badge bg-warning text-dark">@L.Get("Sessions.LiveOrScheduled")</span>
                    }
                    else
                    {

                        <span class="badge bg-light text-dark border">@L.Get("Sessions.NotYet")</span>
                    }
                </td>
                <td>@(r.Total == 0 ? "-" : $"{r.Present} / {r.Absent}")</td>
                <td class="text-nowrap">
                    @if (r.Status != SessionStatus.Cancelled)
                    {
                        if (r.CanTakeAttendance)
                        {
                            <button class="btn btn-sm btn-outline-success" onclick="openForm('@Url.Action("Attendance", "Sessions", new { id = r.Id })', sessionTakeTitle, true)">@L.Get("Sessions.TakeAttendance")</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="@L.Get("Sessions.OpensEarly")">@L.Get("Sessions.TakeAttendance")</button>
                        }

                        <button class="btn btn-sm btn-outline-danger" onclick="confirmPost('@Url.Action("Cancel", "Sessions")', { id: @r.Id }, sessionCancelAsk)">@L.Get("Common.Cancel")</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-primary" onclick="confirmPost('@Url.Action("Restore", "Sessions")', { id: @r.Id }, sessionRestoreAsk)">@L.Get("Sessions.Restore")</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        var sessionTakeTitle = @Json.Serialize(L.Get("Sessions.TakeTitle").Value);
        var sessionCancelAsk = @Json.Serialize(L.Get("Sessions.CancelAsk").Value);
        var sessionRestoreAsk = @Json.Serialize(L.Get("Sessions.RestoreAsk").Value);

        function generateSessions() {
            postJson('@Url.Action("Generate", "Sessions")',
                { groupId: $('#groupId').val(), month: $('#month').val() },
                function (r) { notify('success', r.message, function () { location.reload(); }); });
        }
    </script>
}
