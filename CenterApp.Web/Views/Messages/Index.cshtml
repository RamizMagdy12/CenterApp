@model List<ConversationRow>
@{
    ViewData["Title"] = L.Get("Menu.Messages").Value;
    var unlinked = ViewBag.Unlinked as bool? == true;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@L.Get("Menu.StudentQuestions") <span class="badge bg-secondary">@Model.Count</span></h3>
    <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmPost('@Url.Action("Clear", "Notifications")', {}, '@L.Get("Notify.ClearAllAsk")')">@L.Get("Notify.ClearAll")</button>
</div>

@if (unlinked)
{
    <div class="alert alert-warning">@L.Get("Messages.Unlinked")</div>
}
else if (Model.Count == 0)
{
    <div class="empty-box">@L.Get("Messages.Empty")</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead><tr><th>@L.Get("Common.Student")</th><th>@L.Get("Common.Teacher")</th><th>@L.Get("Messages.Last")</th><th>@L.Get("Common.Time")</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.StudentName <small class="text-muted" dir="ltr">@c.StudentCode</small></td>
                <td>@c.TeacherName</td>
                <td>@c.LastMessage</td>
                <td>@c.When</td>
                <td>
                    @if (c.Unread > 0)
                    {
                        <span class="badge bg-danger">@c.Unread</span>
                    }
                    <a class="btn btn-sm btn-outline-primary" asp-action="Thread" asp-route-id="@c.Id">@L.Get("Common.Open")</a>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmPost('@Url.Action("Delete", "Messages")', { id: @c.Id }, '@L.Get("Notify.ClearChatAsk")')">@L.Get("Common.Clear")</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
