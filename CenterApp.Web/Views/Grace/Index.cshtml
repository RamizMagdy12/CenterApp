@model List<GraceRow>
@{
    ViewData["Title"] = L.Get("Grace.Title").Value;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@L.Get("Grace.Title")</h3>
    <button class="btn btn-primary" onclick="openForm('@Url.Action("Form", "Grace")', '@L.Get("Grace.New")')">+ @L.Get("Grace.New")</button>
</div>

<table class="table table-striped align-middle">
    <thead><tr><th>@L.Get("Common.Student")</th><th>@L.Get("Common.Code")</th><th>@L.Get("Common.Group")</th><th>@L.Get("Grace.Days")</th><th>@L.Get("Grace.LastDay")</th><th>@L.Get("Common.Reason")</th><th>@L.Get("Common.Status")</th><th></th></tr></thead>
    <tbody>
        @foreach (var g in Model)
        {
            <tr>
                <td>@g.StudentName</td>
                <td>@g.StudentCode</td>
                <td>@g.GroupName</td>
                <td>@g.Days</td>
                <td>@g.ExpiresAt.AddDays(-1).ToString("yyyy-MM-dd")</td>
                <td>@g.Reason</td>
                <td>
                    @if (g.IsRevoked)
                    {
                        <span class="badge bg-secondary">@L.Get("Grace.Revoked")</span>
                    }
                    else if (g.IsActive)
                    {

                        <span class="badge bg-success">@L.Get("Grace.Active")</span>
                    }
                    else
                    {

                        <span class="badge bg-light text-dark border">@L.Get("Grace.Expired")</span>
                    }
                </td>
                <td>
                    @if (g.IsActive)
                    {
                        <button class="btn btn-sm btn-outline-danger" onclick="confirmPost('@Url.Action("Revoke", "Grace")', { id: @g.Id }, '@L.Get("Grace.RevokeAsk")')">@L.Get("Common.Cancel")</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>