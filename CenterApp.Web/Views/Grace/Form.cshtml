@model GraceFormVm
@using System.Text.Json
<form id="graceForm" onsubmit="return false;">
    <div class="row g-3">
        <div class="col-12">
            @if (Model.StudentId.HasValue)
            {
                <input type="hidden" name="studentId" value="@Model.StudentId" />
                <div>الطالب: <strong>@Model.StudentName</strong></div>
            }
            else
            {
                <label class="form-label">الطالب</label>
                <input id="gStu" list="gStuList" class="form-control" placeholder="ابحث بالاسم أو الكود..." autocomplete="off" />
                <datalist id="gStuList">@foreach (var s in Model.Students) {
                    <option value="@s.Text"></option>
                }
            </datalist>
            <input type="hidden" name="studentId" id="gStuId" />
        }
    </div>
    <div class="col-md-6">
        <label class="form-label">المجموعة</label>
        <select name="groupId" class="form-select">
            <option value="">كل المجموعات</option>
            @foreach (var g in Model.Groups)
            {
                <option value="@g.Id" selected="@(g.Id == Model.GroupId)">@g.Text</option>
            }
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label">عدد الأيام (من النهارده)</label>
        <input name="days" type="number" min="1" max="90" value="3" class="form-control" />
    </div>
    <div class="col-12"><label class="form-label">السبب (اختياري)</label><input name="reason" class="form-control" /></div>
    <div class="col-12"><button class="btn btn-success" onclick="saveGrace()">إعطاء السماح</button></div>
</div>
</form>

<script>
    var stuMap = @Html.Raw(JsonSerializer.Serialize(Model.Students.ToDictionary(s => s.Text, s => s.Id)));
    $('#gStu').on('input change', function () { $('#gStuId').val(stuMap[this.value] || ''); });

    function saveGrace() {
        if (!$('#graceForm [name=studentId]').val()) { notify('warning', 'اختار الطالب من القائمة'); return; }
        submitForm('#graceForm', '@Url.Action("Save", "Grace")');
    }
</script>