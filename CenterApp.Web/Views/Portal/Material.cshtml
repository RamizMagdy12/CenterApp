@model PortalViewVm
@{
    Layout = "_PortalLayout"; ViewData["Title"] = Model.Row.Title;
}

<a class="btn btn-sm btn-light mb-3" asp-action="Materials"><i class="bi @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "bi-arrow-right" : "bi-arrow-left")"></i> @L.Get("Menu.Materials")</a>
<h3>@Model.Row.Title</h3>
<p class="text-muted">@Model.Row.Groups • @Model.Row.PublishedAt.ToString("yyyy-MM-dd")</p>

@if (Model.Row.IsLocked)
{
    <div class="panel text-center" style="max-width:520px;margin:30px auto;">
        <div style="font-size:56px;color:#c53030"><i class="bi bi-lock-fill"></i></div>
        <h4 class="mt-2">@L.Get("Portal.MaterialLocked")</h4>
        <p class="text-muted">@Model.Row.Reason</p>
        <p>@L.Get("Portal.PayToOpen")</p>
    </div>
}
else
{
    @if (Model.Row.GraceUntil.HasValue)
    {
        <div class="alert alert-warning">@L.Get("Portal.GraceUntilMaterial", Model.Row.GraceUntil.Value.AddDays(-1).ToString("yyyy-MM-dd"))</div>
    }
    <partial name="_MaterialViewer" model="Model.Viewer" />
}
