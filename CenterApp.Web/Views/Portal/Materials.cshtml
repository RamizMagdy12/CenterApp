@model List<PortalMaterialRow>
@{
    Layout = "_PortalLayout"; ViewData["Title"] = "الماتريال";
}
<h3 class="mb-3">الماتريال <span class="badge bg-secondary">@Model.Count</span></h3>
@if (Model.Count == 0)
{
    <div class="panel empty-box">مفيش ماتريال متاحة لمجموعاتك لسه</div>
}
<div class="mgrid">
    @foreach (var m in Model)
    {
        <partial name="_MaterialCard" model="m" />
    }
</div>