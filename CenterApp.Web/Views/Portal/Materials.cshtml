@model List<PortalMaterialRow>
@{
    Layout = "_PortalLayout"; ViewData["Title"] = L.Get("Menu.Materials").Value;
}
<h3 class="mb-3">@L.Get("Menu.Materials") <span class="badge bg-secondary">@Model.Count</span></h3>
@if (Model.Count == 0)
{
    <div class="panel empty-box">@L.Get("Portal.NoMaterialsForGroups")</div>
}
<div class="mgrid">
    @foreach (var m in Model)
    {
        <partial name="_MaterialCard" model="m" />
    }
</div>
