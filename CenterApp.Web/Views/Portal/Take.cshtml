@model ExamTakeVm
@{
    Layout = "_ExamLayout";
    ViewData["Title"] = Model.Title;
}
<style>
    body.exam-body { margin: 0; background: #f3f6f7; color: #1a2c3a; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
    @@media print { html, body { display: none !important; } }
    .exam-top { position: sticky; top: 0; z-index: 20; background: #fff; border-bottom: 1px solid #e3eaee; display: flex; gap: 12px; align-items: center; padding: 12px 18px; flex-wrap: wrap; }
    .exam-top b { font-size: 18px; }
    .exam-timer { margin-inline-start: auto; font-weight: 800; font-size: 20px; font-variant-numeric: tabular-nums; }
    .exam-timer.late { color: #c53030; }
    .exam-sheet { position: relative; z-index: 2; max-width: 820px; margin: 0 auto; padding: 18px; }
    .q-card { background: #fff; border: 1px solid #e3eaee; border-radius: 14px; padding: 16px; margin-bottom: 14px; }
    .q-card h4 { font-size: 18px; margin-bottom: 10px; }
    .q-body { display: flex; gap: 16px; align-items: flex-start; }
    .q-main { flex: 1; min-width: 0; }
    .q-fig { width: 240px; max-width: 42%; height: auto; border-radius: 10px; border: 1px solid #e3eaee; flex: none; pointer-events: none; }
    @@media (max-width: 640px) { .q-body { flex-direction: column; } .q-fig { width: 100%; max-width: 100%; } }
    .choice { display: flex; gap: 10px; align-items: flex-start; border: 1px solid #e3eaee; border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; cursor: pointer; }
    .choice:has(input:checked) { border-color: #146278; background: #e7f4f6; }
    .exam-watermark { position: fixed; inset: -20%; z-index: 6; display: flex; flex-wrap: wrap; align-content: space-around; justify-content: space-around; transform: rotate(-18deg); pointer-events: none; }
    .exam-watermark span { margin: 22px 28px; font-size: 14px; font-weight: 800; color: rgba(20,98,120,.18); white-space: nowrap; }
    #shotCover { position: fixed; inset: 0; background: #102433; z-index: 90; display: none; }
    .gate, .done { position: fixed; inset: 0; background: rgba(16,36,51,.72); z-index: 40; display: grid; place-items: center; padding: 18px; }
    .gate-card, .done-card { background: #fff; border-radius: 16px; padding: 22px; max-width: 460px; width: 100%; }
    .hidden-qs { visibility: hidden; }
</style>

<div class="exam-watermark" aria-hidden="true">
    @for (var w = 0; w < 24; w++)
    {
        <span>@Model.StudentCode · @Model.StudentName</span>
    }
</div>
<div id="shotCover"></div>
<header class="exam-top">
    <div>
        <b>@Model.Title</b>
        <div class="text-muted small">@Model.StudentName · @Model.StudentCode</div>
    </div>
    <div class="exam-timer" id="timer">--:--</div>
    <button type="button" class="btn btn-success" id="btnFinish" disabled onclick="askFinish()">@L.Get("Portal.Submit")</button>
</header>

<div class="exam-sheet hidden-qs" id="sheet">
    @for (var i = 0; i < Model.Questions.Count; i++)
    {
        var q = Model.Questions[i];
        <article class="q-card" data-qid="@q.Id">
            <div class="q-body">
                <div class="q-main">
                    <h4>@(i + 1). @q.Text <small class="text-muted">(@L.Get("Portal.Points", q.Points.ToString("0.##")))</small></h4>
                    @foreach (var c in q.Choices)
                    {
                        <label class="choice">
                            <input type="radio" name="q_@q.Id" value="@c.Id" @(q.SelectedChoiceId == c.Id ? "checked" : "") />
                            <span>@c.Text</span>
                        </label>
                    }
                </div>
                @if (q.HasImage)
                {
                    <img class="q-fig" draggable="false" alt="" src="@Url.Action("ExamImage", "Portal", new { id = q.Id })" />
                }
            </div>
        </article>
    }
</div>

<div class="gate" id="gate">
    <div class="gate-card">
        <h3>@L.Get("Portal.BeforeStart")</h3>
        <p>@L.Get("Portal.GateRules")</p>
        <p class="text-muted">@L.Get("Portal.ResultsAt", Model.ResultsAt.ToString("yyyy-MM-dd HH:mm"))</p>
        <button type="button" class="btn btn-primary" id="btnEnter">@L.Get("Portal.EnterExam")</button>
    </div>
</div>
<div class="done" id="done" style="display:none">
    <div class="done-card">
        <h3 id="doneTitle">@L.Get("Portal.Submitted")</h3>
        <p id="doneText"></p>
        <a id="doneBack" class="btn btn-primary mt-2" style="display:none" href="@Url.Action("Exam", "Portal", new { id = Model.ExamId })">@L.Get("Portal.BackToExam")</a>
    </div>
</div>

@section Scripts {
    <script>
        var examId = @Model.ExamId;
        var endsAt = Date.now() + (@Model.RemainingSeconds * 1000);
        var resultsText = '@Model.ResultsAt.ToString("yyyy-MM-dd HH:mm")';
        var armed = false, finished = false, escAsking = false, shotLock = false, saveTimer = null;
        var txtNoScreenshots = @Json.Serialize(L.Get("Portal.NoScreenshots").Value);
        var txtScreenshotBlocked = @Json.Serialize(L.Get("Portal.ScreenshotBlocked").Value);
        var txtReturn = @Json.Serialize(L.Get("Portal.ReturnToExam").Value);
        var txtSubmitted = @Json.Serialize(L.Get("Portal.Submitted").Value);
        var txtExamClosed = @Json.Serialize(L.Get("Portal.ExamClosed").Value);
        var txtAnswersSaved = @Json.Serialize(L.Get("Portal.AnswersSaved").Value);
        var txtTimeoutSaved = @Json.Serialize(L.Get("Portal.TimeoutSaved").Value);
        var txtLeftSubmitted = @Json.Serialize(L.Get("Portal.LeftSubmitted").Value);
        var txtSubmitAsk = @Json.Serialize(L.Get("Portal.SubmitAsk").Value);
        var txtNoEditAfter = @Json.Serialize(L.Get("Portal.NoEditAfter").Value);
        var txtSubmit = @Json.Serialize(L.Get("Portal.Submit").Value);
        var txtBack = @Json.Serialize(L.Get("Portal.Back").Value);
        var txtLeftFullscreen = @Json.Serialize(L.Get("Portal.LeftFullscreen").Value);
        var txtEscHint = @Json.Serialize(L.Get("Portal.EscHint").Value);
        var txtSubmitExam = @Json.Serialize(L.Get("Portal.SubmitExam").Value);
        var txtFullscreenRequired = @Json.Serialize(L.Get("Portal.FullscreenRequired").Value);
        var txtAllowFullscreen = @Json.Serialize(L.Get("Portal.AllowFullscreen").Value);

        function isShotKey(e) {
            var k = e.key || '';
            var code = e.code || '';
            if (k === 'PrintScreen' || code === 'PrintScreen' || code === 'F13') return true;
            if (k === 'Meta' || code === 'MetaLeft' || code === 'MetaRight' || code === 'OSLeft' || code === 'OSRight') return true;
            if (e.metaKey || (e.getModifierState && e.getModifierState('OS'))) return true;
            if ((e.metaKey || e.ctrlKey) && e.shiftKey && ['s', '3', '4', '5'].indexOf(k.toLowerCase()) >= 0) return true;
            return false;
        }
        function blankShot() {
            document.getElementById('shotCover').style.display = 'block';
            document.getElementById('sheet').style.display = 'none';
            document.querySelector('.exam-top').style.visibility = 'hidden';
            document.querySelector('.exam-watermark').style.visibility = 'hidden';
            if (!escAsking) document.getElementById('done').style.display = 'none';
        }
        function showExam() {
            document.getElementById('shotCover').style.display = 'none';
            document.getElementById('sheet').style.display = '';
            document.getElementById('sheet').classList.remove('hidden-qs');
            document.querySelector('.exam-top').style.visibility = '';
            document.querySelector('.exam-watermark').style.visibility = '';
        }
        function wipeClipboard() {
            var n = 0;
            var id = setInterval(function () {
                try {
                    if (navigator.clipboard && navigator.clipboard.writeText)
                        navigator.clipboard.writeText('\u200b').catch(function () { });
                } catch (e) { }
                if (++n > 15) clearInterval(id);
            }, 70);
        }
        function askShot() {
            if (!armed || finished) return;
            blankShot();
            wipeClipboard();
            if (shotLock) return;
            shotLock = true;
            setTimeout(function () {
                if (!shotLock || finished) return;
                var box = document.getElementById('done');
                document.getElementById('doneBack').style.display = 'none';
                box.style.zIndex = '100';
                box.style.display = 'grid';
                document.getElementById('doneTitle').textContent = txtNoScreenshots;
                document.getElementById('doneText').innerHTML = '';
                var p = document.createElement('p');
                p.textContent = txtScreenshotBlocked;
                var back = document.createElement('button');
                back.className = 'btn btn-primary';
                back.textContent = txtReturn;
                back.onclick = function () {
                    shotLock = false;
                    box.style.display = 'none';
                    showExam();
                    lockKeys();
                };
                document.getElementById('doneText').appendChild(p);
                document.getElementById('doneText').appendChild(back);
            }, 700);
        }

        ['copy', 'cut', 'paste', 'contextmenu', 'dragstart', 'selectstart'].forEach(function (ev) {
            document.addEventListener(ev, function (e) { e.preventDefault(); });
        });
        document.addEventListener('keydown', function (e) {
            if (isShotKey(e)) { e.preventDefault(); e.stopPropagation(); askShot(); return; }
            var k = (e.key || '').toLowerCase();
            if ((e.ctrlKey || e.metaKey) && ['c', 'v', 'x', 'a', 'p', 's', 'u'].indexOf(k) >= 0) e.preventDefault();
            if (k === 'f12' || (e.ctrlKey && e.shiftKey && ['i', 'j', 'c'].indexOf(k) >= 0)) e.preventDefault();
            if (e.key === 'Escape' && armed && !finished) {
                e.preventDefault();
                e.stopPropagation();
                askEsc();
            }
        }, true);
        document.addEventListener('keyup', function (e) {
            if (!isShotKey(e)) return;
            e.preventDefault();
            askShot();
        }, true);

        function tick() {
            var left = Math.max(0, Math.floor((endsAt - Date.now()) / 1000));
            var m = Math.floor(left / 60), s = left % 60;
            var el = document.getElementById('timer');
            el.textContent = String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
            el.classList.toggle('late', left < 60);
            if (armed && left <= 0) endExam('timeout');
        }
        setInterval(tick, 250);
        tick();

        function payload(reason) {
            var answers = [];
            document.querySelectorAll('.q-card').forEach(function (card) {
                var picked = card.querySelector('input:checked');
                answers.push({ QuestionId: parseInt(card.getAttribute('data-qid'), 10), ChoiceId: picked ? parseInt(picked.value, 10) : null });
            });
            return { ExamId: examId, Reason: reason || 'submit', Answers: answers };
        }

        function postExam(url, reason) {
            return fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify(payload(reason)),
                credentials: 'same-origin'
            }).then(function (r) { return r.json(); });
        }

        function beacon(reason) {
            try {
                var blob = new Blob([JSON.stringify(payload(reason))], { type: 'application/json' });
                navigator.sendBeacon('@Url.Action("SubmitExam", "Portal")', blob);
            } catch (e) { }
        }

        function showDone(title, text) {
            finished = true;
            escAsking = false;
            shotLock = false;
            document.getElementById('shotCover').style.display = 'none';
            document.getElementById('doneTitle').textContent = title;
            document.getElementById('doneText').textContent = text;
            document.getElementById('doneBack').style.display = '';
            var box = document.getElementById('done');
            box.style.zIndex = '100';
            box.style.display = 'grid';
            document.getElementById('gate').style.display = 'none';
            document.getElementById('btnFinish').disabled = true;
            if (document.fullscreenElement && document.exitFullscreen) document.exitFullscreen().catch(function () { });
        }

        function endExam(reason) {
            if (finished) return;
            finished = true;
            var title = reason === 'submit' ? txtSubmitted : txtExamClosed;
            var text = reason === 'submit'
                ? txtAnswersSaved.replace('{0}', resultsText)
                : (reason === 'timeout'
                    ? txtTimeoutSaved.replace('{0}', resultsText)
                    : txtLeftSubmitted.replace('{0}', resultsText));
            postExam('@Url.Action("SubmitExam", "Portal")', reason)
                .then(function () { showDone(title, text); })
                .catch(function () { beacon(reason); showDone(title, text); });
            if (document.fullscreenElement && document.exitFullscreen) document.exitFullscreen().catch(function () { });
        }

        function askFinish() {
            if (!armed || finished) return;
            var box = document.getElementById('done');
            document.getElementById('doneBack').style.display = 'none';
            box.style.zIndex = '100';
            box.style.display = 'grid';
            document.getElementById('doneTitle').textContent = txtSubmitAsk;
            document.getElementById('doneText').innerHTML = '';
            var p = document.createElement('p');
            p.textContent = txtNoEditAfter;
            var yes = document.createElement('button');
            yes.className = 'btn btn-success';
            yes.textContent = txtSubmit;
            yes.onclick = function () { endExam('submit'); };
            var no = document.createElement('button');
            no.className = 'btn btn-light';
            no.style.marginInlineStart = '8px';
            no.textContent = txtBack;
            no.onclick = function () { box.style.display = 'none'; };
            document.getElementById('doneText').appendChild(p);
            document.getElementById('doneText').appendChild(yes);
            document.getElementById('doneText').appendChild(no);
        }

        function askEsc() {
            if (!armed || finished || escAsking) return;
            escAsking = true;
            var box = document.getElementById('done');
            document.getElementById('doneBack').style.display = 'none';
            box.style.zIndex = '100';
            box.style.display = 'grid';
            document.getElementById('doneTitle').textContent = txtLeftFullscreen;
            document.getElementById('doneText').innerHTML = '';
            var p = document.createElement('p');
            p.textContent = txtEscHint;
            var back = document.createElement('button');
            back.className = 'btn btn-primary';
            back.textContent = txtReturn;
            back.onclick = function () {
                escAsking = false;
                box.style.display = 'none';
                showExam();
                var el = document.documentElement;
                var req = el.requestFullscreen || el.webkitRequestFullscreen;
                if (req) Promise.resolve(req.call(el)).then(lockKeys).catch(function () { askEsc(); });
            };
            var leave = document.createElement('button');
            leave.className = 'btn btn-outline-danger';
            leave.style.marginInlineStart = '8px';
            leave.textContent = txtSubmitExam;
            leave.onclick = function () { escAsking = false; endExam('fullscreen'); };
            document.getElementById('doneText').appendChild(p);
            document.getElementById('doneText').appendChild(back);
            document.getElementById('doneText').appendChild(leave);
        }

        function lockKeys() {
            if (!navigator.keyboard || !navigator.keyboard.lock || !document.fullscreenElement) return;
            navigator.keyboard.lock().catch(function () {
                return navigator.keyboard.lock(['PrintScreen', 'Escape', 'F13', 'MetaLeft', 'MetaRight']);
            }).catch(function () { });
        }

        function begin() {
            armed = true;
            lockKeys();
            document.getElementById('gate').style.display = 'none';
            document.getElementById('shotCover').style.display = 'none';
            document.getElementById('sheet').classList.remove('hidden-qs');
            document.getElementById('btnFinish').disabled = false;
            document.querySelectorAll('.q-card input').forEach(function (input) {
                input.addEventListener('change', function () {
                    clearTimeout(saveTimer);
                    saveTimer = setTimeout(function () { postExam('@Url.Action("Sync", "Portal")', 'submit').catch(function () { }); }, 250);
                });
            });
            setInterval(function () {
                if (!armed || finished) return;
                postExam('@Url.Action("Sync", "Portal")', 'submit').then(function (r) {
                    if (r && r.finished) showDone(txtExamClosed, r.message || txtSubmitted);
                }).catch(function () { });
            }, 10000);
        }

        document.getElementById('btnEnter').onclick = function () {
            var el = document.documentElement;
            var req = el.requestFullscreen || el.webkitRequestFullscreen;
            if (!req) { begin(); return; }
            Promise.resolve(req.call(el)).then(function () { lockKeys(); begin(); }).catch(function () {
                document.getElementById('doneBack').style.display = '';
                document.getElementById('done').style.display = 'grid';
                document.getElementById('doneTitle').textContent = txtFullscreenRequired;
                document.getElementById('doneText').textContent = txtAllowFullscreen;
            });
        };

        document.addEventListener('fullscreenchange', function () {
            if (document.fullscreenElement) lockKeys();
            else if (armed && !finished) askEsc();
        });
        document.addEventListener('visibilitychange', function () {
            if (armed && !finished && document.visibilityState === 'hidden') {
                blankShot();
                endExam('left');
            }
        });
        window.addEventListener('blur', function () {
            if (!armed || finished) return;
            blankShot();
            wipeClipboard();
        });
        window.addEventListener('focus', function () {
            if (!armed || finished || shotLock || escAsking || document.visibilityState !== 'visible') return;
            setTimeout(function () {
                if (shotLock || escAsking || finished || document.visibilityState !== 'visible') return;
                showExam();
            }, 800);
        });
        window.addEventListener('pagehide', function () {
            if (armed && !finished) beacon('left');
        });
        history.pushState(null, '', location.href);
        window.addEventListener('popstate', function () {
            history.pushState(null, '', location.href);
            if (armed && !finished) endExam('left');
        });
    </script>
}
