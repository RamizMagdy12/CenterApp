@model ExamIntroVm
@{
    Layout = "_PortalLayout"; ViewData["Title"] = Model.Title;
}
<div class="panel">
    <h3>@Model.Title</h3>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p>@Model.Description</p>
    }
    @if (TempData["ExamError"] is string err)
    {
        <div class="alert alert-danger">@err</div>
    }
    <ul class="mb-3">
        <li>@L.Get("Portal.Opens"): <b>@Model.OpensAt.ToString("yyyy-MM-dd HH:mm")</b></li>
        <li>@L.Get("Portal.Closes"): <b>@Model.ClosesAt.ToString("yyyy-MM-dd HH:mm")</b></li>
        <li>@L.Get("Portal.ResultsForAll"): <b>@Model.ResultsAt.ToString("yyyy-MM-dd HH:mm")</b></li>
        <li>@L.Get("Portal.QuestionCount"): <b>@Model.QuestionsCount</b> · @L.Get("Portal.OutOf") <b>@Model.MaxScore.ToString("0.##")</b></li>
    </ul>

    @if (Model.Phase == "result" && Model.Score != null)
    {
        <div class="alert alert-success">@L.Get("Portal.YourScoreLabel"): <strong>@Model.Score.Value.ToString("0.##") / @Model.MaxScore.ToString("0.##")</strong></div>
    }
    else if (Model.Phase == "submitted")
    {
        <div class="alert alert-info">@L.Get("Portal.SubmittedWait", Model.ResultsAt.ToString("yyyy-MM-dd HH:mm"))</div>
    }
    else if (Model.Phase == "missed")
    {
        <div class="alert alert-warning">@L.Get("Portal.Missed")</div>
    }
    else if (Model.Phase == "closed")
    {
        <div class="alert alert-warning">@L.Get("Portal.ClosedWait", Model.ResultsAt.ToString("yyyy-MM-dd HH:mm"))</div>
    }
    else if (Model.Phase == "upcoming")
    {
        <div class="alert alert-secondary">@L.Get("Portal.Upcoming", Model.OpensAt.ToString("yyyy-MM-dd HH:mm"))</div>
    }
    else if (Model.Phase == "once")
    {
        <div class="alert alert-warning">@L.Get("Portal.GraceOnce")</div>
        <form asp-action="StartExam" asp-route-id="@Model.Id" method="post">
            <button class="btn btn-primary">@L.Get("Portal.Start")</button>
        </form>
    }
    else if (Model.Phase == "used")
    {
        <div class="alert alert-warning">@L.Get("Portal.GraceUsed")</div>
    }
    else
    {
        <div class="alert alert-warning">
            @L.Get("Portal.ExamRules")
        </div>
        <form asp-action="StartExam" asp-route-id="@Model.Id" method="post">
            <button class="btn btn-primary">@(Model.CanResume ? L.Get("Portal.Resume") : L.Get("Portal.Start"))</button>
        </form>
    }
    <a class="btn btn-light mt-3" asp-action="Exams">@L.Get("Portal.Back")</a>
</div>
