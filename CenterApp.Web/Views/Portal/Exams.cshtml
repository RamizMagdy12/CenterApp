@model StudentExamsVm
@{
    Layout = "_PortalLayout"; ViewData["Title"] = L.Get("Menu.Exams").Value;
}
<h3 class="mb-3">@L.Get("Menu.OnlineExams")</h3>
@if (Model.Online.Count == 0)
{
    <div class="panel empty-box">@L.Get("Portal.NoOnlineExams")</div>
}
<div class="mgrid mb-4">
    @foreach (var m in Model.Online)
    {
        <a class="mcard" asp-action="Exam" asp-route-id="@m.Id">
            <i class="bi bi-patch-question mcard-ico"></i>
            <span class="mcard-body">
                <b>@m.Title</b>
                <small>@m.OpensAt.ToString("yyyy-MM-dd HH:mm") → @m.ClosesAt.ToString("HH:mm")</small>
                <small>@L.Get("Portal.QuestionScore", m.QuestionsCount, m.MaxScore.ToString("0.##"))</small>
                @if (m.Phase == "result" && m.Score != null)
                {
                    <span class="pill pill-ok">@L.Get("Portal.YourScore", m.Score.Value.ToString("0.##"), m.MaxScore.ToString("0.##"))</span>
                }
                else
                {
                    <span class="pill @(m.CanStart || m.CanResume ? "pill-primary" : "pill-gray")">@(m.Phase == "once" ? L.Get("Portal.GraceOnceShort") : m.Phase == "used" ? L.Get("Portal.GraceUsedShort") : m.PhaseText)</span>
                }
            </span>
        </a>
    }
</div>

<h3 class="mb-3">@L.Get("Portal.PaperGrades")</h3>
@if (Model.Offline.Count == 0)
{
    <div class="panel empty-box">@L.Get("Portal.NoOfflineGrades")</div>
}
else
{
    <div class="panel">
        <table class="table table-striped align-middle mb-0">
            <thead><tr><th>@L.Get("Portal.Exam")</th><th>@L.Get("Common.Group")</th><th>@L.Get("Portal.Date")</th><th>@L.Get("Portal.Score")</th></tr></thead>
            <tbody>
                @foreach (var m in Model.Offline)
                {
                    <tr>
                        <td>@m.Title</td>
                        <td>@m.GroupName</td>
                        <td>@m.ExamDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (m.Score == null)
                            {
                                <span class="text-muted">@L.Get("Portal.NotGraded")</span>
                            }
                            else
                            {
                                <strong>@m.Score.Value.ToString("0.##")</strong>
                                <span class="text-muted">/ @m.MaxScore.ToString("0.##")</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
