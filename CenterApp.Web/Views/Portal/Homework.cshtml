@model List<PortalHomeworkRow>
@{
    Layout = "_PortalLayout"; ViewData["Title"] = L.Get("Menu.Homework").Value;
}
<h3 class="mb-3">@L.Get("Menu.Homework") <span class="badge bg-secondary">@Model.Count</span></h3>
@if (Model.Count == 0)
{
    <div class="panel empty-box">@L.Get("Portal.NoHomeworkForGroups")</div>
}
<div class="mgrid">
    @foreach (var m in Model)
    {
        <partial name="_HomeworkCard" model="m" />
    }
</div>
