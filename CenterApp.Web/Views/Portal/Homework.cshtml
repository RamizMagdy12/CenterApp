@model List<PortalHomeworkRow>
@{
    Layout = "_PortalLayout"; ViewData["Title"] = "الواجبات";
}
<h3 class="mb-3">الواجبات <span class="badge bg-secondary">@Model.Count</span></h3>
@if (Model.Count == 0)
{
    <div class="panel empty-box">مفيش واجبات متاحة لمجموعاتك لسه</div>
}
<div class="mgrid">
    @foreach (var m in Model)
    {
        <partial name="_HomeworkCard" model="m" />
    }
</div>
