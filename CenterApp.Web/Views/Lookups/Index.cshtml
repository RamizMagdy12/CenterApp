@model List<LookupVm>
@{
    var type = (string)ViewBag.Type;
    ViewData["Title"] = (string)ViewBag.Title;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@ViewBag.Title</h3>
    <button class="btn btn-primary" onclick="openForm('@Url.Action("Form", "Lookups", new { type })', '@ViewBag.Title')">+ @L.Get("Common.Add")</button>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>@L.Get("Common.Name")</th>
            @if (type == "teachers")
            {
                <th>@L.Get("Common.Phone")</th>
                <th>@L.Get("Common.Status")</th>
            }
            @if (type == "gradelevels")
            {
                <th>@L.Get("Lookups.Sort")</th>
            }
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Id</td>
                <td>@Bilingual.Show(r.Name, r.NameEn)</td>
                @if (type == "teachers")
                {
                    <td>@r.Phone</td>
                    <td>@if (r.IsActive) {
                        <span class="badge bg-success">@L.Get("Common.Active")</span>
                    } else
                    {

                        <span class="badge bg-secondary">@L.Get("Common.InactiveAlt")</span>
                    }
                </td>
            }
            @if (type == "gradelevels")
            {
                <td>@r.SortOrder</td>
            }
            <td class="text-nowrap">
                <button class="btn btn-sm btn-outline-primary" onclick="openForm('@Url.Action("Form", "Lookups", new { type, id = r.Id })', '@ViewBag.Title')">@L.Get("Common.Edit")</button>
                <button class="btn btn-sm btn-outline-danger" onclick="confirmPost('@Url.Action("Delete", "Lookups")', { type: '@type', id: @r.Id }, '@L.Get("Common.ConfirmDelete")')">@L.Get("Common.Delete")</button>
            </td>
        </tr>
    }
</tbody>
</table>