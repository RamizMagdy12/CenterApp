@model DiscountFormVm
<p class="mb-2"><strong>@Model.StudentName</strong></p>
<p class="text-muted small">@L.Get("Invoices.DiscountHelp")</p>
@if (Model.BasePrices.Count > 0)
{
    <p class="small mb-3">@L.Get("Invoices.CurrentPrices", string.Join(L.Get("Invoices.ListSep").Value, Model.BasePrices.Select(p => L.Get("Invoices.Egp", p.ToString("N2")).Value)))</p>
}

<form id="discountForm" onsubmit="return false;">
    <input type="hidden" name="studentId" value="@Model.StudentId" />
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">@L.Get("Invoices.DiscountType")</label>
            <select name="kind" id="discountKind" class="form-select" onchange="previewDiscount()">
                <option value="0" selected="@(Model.Kind == DiscountKind.None)">@L.Get("Invoices.None")</option>
                <option value="1" selected="@(Model.Kind == DiscountKind.Percentage)">@L.Get("Invoices.Percent")</option>
                <option value="2" selected="@(Model.Kind == DiscountKind.Fixed)">@L.Get("Invoices.Fixed")</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">@L.Get("Invoices.DiscountValue")</label>
            <input name="value" id="discountValue" type="number" min="0" step="0.01" class="form-control" value="@Model.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" oninput="previewDiscount()" />
        </div>
        <div class="col-12">
            <div class="alert alert-light border mb-0" id="discountPreview">@L.Get("Invoices.PreviewPlaceholder")</div>
        </div>
        <div class="col-12 d-flex gap-2">
            <button type="button" class="btn btn-primary" onclick="submitForm('#discountForm', '@Url.Action("Discount", "Invoices")')">@L.Get("Invoices.SaveDiscount")</button>
            <button type="button" class="btn btn-outline-danger" onclick="removeDiscount()">@L.Get("Invoices.RemoveDiscount")</button>
        </div>
    </div>
</form>
<script>
    var discountBases = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BasePrices));
    function previewDiscount() {
        var kind = document.getElementById('discountKind').value;
        var value = parseFloat(document.getElementById('discountValue').value);
        if (isNaN(value)) value = 0;
        var box = document.getElementById('discountPreview');
        if (kind === '0' || value <= 0) {
            box.textContent = @Json.Serialize(L.Get("Invoices.NoPermanent").Value);
            return;
        }
        if (!discountBases.length) {
            box.textContent = kind === '1'
                ? (@Json.Serialize(L.Get("Invoices.PercentApply").Value)).replace('{0}', value)
                : (@Json.Serialize(L.Get("Invoices.FixedApply").Value)).replace('{0}', value.toFixed(2));
            return;
        }
        var lineTpl = @Json.Serialize(L.Get("Invoices.PreviewLine").Value);
        var lines = discountBases.map(function (base) {
            var discount = kind === '1' ? Math.round(base * value) / 100 : value;
            if (discount > base) discount = base;
            if (discount < 0) discount = 0;
            var net = base - discount;
            return lineTpl.replace('{0}', base.toFixed(2)).replace('{1}', discount.toFixed(2)).replace('{2}', net.toFixed(2));
        });
        box.textContent = lines.join(' | ');
    }
    function removeDiscount() {
        postJson('@Url.Action("Discount", "Invoices")', { studentId: @Model.StudentId, kind: 0, value: 0 });
    }
    previewDiscount();
</script>
