@model List<InvoiceRow>
@{
    ViewData["Title"] = "التحصيل";
    var groups = (List<SelectListItem>)ViewBag.Groups;
    var gid = ((long)ViewBag.GroupId).ToString();
    var st = (int)ViewBag.Status;
    var sort = (string)ViewBag.Sort;
    var search = (string)ViewBag.Search;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">التحصيل</h3>
</div>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-2">
        <label class="form-label">الشهر</label>
        <input type="month" name="month" value="@ViewBag.Month" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">الاسم الكامل</label>
        <input type="search" name="q" value="@search" class="form-control" placeholder="بحث بالاسم" />
    </div>
    <div class="col-md-2">
        <label class="form-label">المجموعة</label>
        <select name="groupId" class="form-select">
            <option value="0">كل المجموعات</option>
            @foreach (var g in groups)
            {
                <option value="@g.Value" selected="@(g.Value == gid)">@g.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">حالة الدفع</label>
        <select name="status" class="form-select">
            <option value="-1" selected="@(st == -1)">الكل</option>
            <option value="0" selected="@(st == 0)">غير مدفوع</option>
            <option value="1" selected="@(st == 1)">مدفوع جزئياً</option>
            <option value="2" selected="@(st == 2)">مدفوع</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">الترتيب</label>
        <select name="sort" class="form-select">
            <option value="" selected="@(sort == "")">الاسم</option>
            <option value="balance-desc" selected="@(sort == "balance-desc")">المتبقي من الأعلى</option>
            <option value="balance-asc" selected="@(sort == "balance-asc")">المتبقي من الأقل</option>
            <option value="due-asc" selected="@(sort == "due-asc")">تاريخ الاستحقاق الأقرب</option>
            <option value="due-desc" selected="@(sort == "due-desc")">تاريخ الاستحقاق الأبعد</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary">عرض</button>
    </div>
</form>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <div class="alert alert-light border mb-0">صافي المستحق: <strong>@Money(Model.Sum(x => x.NetDue))</strong></div>
    </div>
    <div class="col-md-4">
        <div class="alert alert-success mb-0">إجمالي المدفوع: <strong>@Money(Model.Sum(x => x.Paid))</strong></div>
    </div>
    <div class="col-md-4">
        <div class="alert alert-danger mb-0">المتبقي: <strong>@Money(Model.Sum(x => x.Remaining))</strong></div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>الاسم الكامل</th>
                <th>المجموعة</th>
                <th>سعر الاشتراك</th>
                <th>الخصم الدائم</th>
                <th>قيمة الخصم</th>
                <th>صافي المستحق</th>
                <th>إجمالي المدفوع</th>
                <th>المتبقي</th>
                <th>حالة الدفع</th>
                <th>تاريخ الاستحقاق</th>
                <th>آخر دفعة</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="12" class="text-muted text-center py-4">لا توجد تحصيلات لهذا الشهر.</td></tr>
            }
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.StudentName</td>
                    <td>@r.GroupName</td>
                    <td>@Money(r.Amount)</td>
                    <td>@PermanentDiscount(r)</td>
                    <td>@Money(r.Discount)</td>
                    <td><strong>@Money(r.NetDue)</strong></td>
                    <td>@Money(r.Paid)</td>
                    <td>@Money(r.Remaining)</td>
                    <td>@StatusBadge(r.Status)</td>
                    <td class="text-nowrap">@r.DueDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-nowrap">@(r.LastPaymentDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    <td class="text-nowrap">
                        <div class="d-flex gap-1 flex-wrap">
                            @if (r.Remaining > 0)
                            {
                                <button type="button" class="btn btn-sm btn-outline-success" onclick="openForm('@Url.Action("Pay", "Invoices", new { id = r.Id })', 'تسجيل دفعة')">تسجيل دفعة</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openForm('@Url.Action("Pay", "Invoices", new { id = r.Id })', 'سجل الدفعات')">السجل</button>
                            }
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="openForm('@Url.Action("Discount", "Invoices", new { studentId = r.StudentId })', 'الخصم الدائم', true)">الخصم</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@functions {
    string Money(decimal amount) => $"{amount:N2} ج.م";

    string PermanentDiscount(InvoiceRow r) => r.DiscountKind switch
    {
        DiscountKind.Percentage => $"{r.DiscountValue:0.##}%",
        DiscountKind.Fixed => Money(r.DiscountValue),
        _ => "بدون"
    };

    Microsoft.AspNetCore.Html.IHtmlContent StatusBadge(InvoiceStatus status)
    {
        var (css, label) = status switch
        {
            InvoiceStatus.Paid => ("bg-success", "مدفوع"),
            InvoiceStatus.PartiallyPaid => ("bg-warning text-dark", "مدفوع جزئياً"),
            InvoiceStatus.Waived => ("bg-secondary", "معفى"),
            _ => ("bg-danger", "غير مدفوع")
        };
        return Html.Raw($@"<span class=""badge {css}"">{label}</span>");
    }
}
