@model List<InvoiceRow>
@{
    ViewData["Title"] = "الفواتير والتحصيل";
    var groups = (List<SelectListItem>)ViewBag.Groups;
    var gid = ((long)ViewBag.GroupId).ToString();
    var st = (int)ViewBag.Status;
}
<h3 class="mb-3">الفواتير والتحصيل</h3>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-2"><label class="form-label">الشهر</label><input type="month" id="month" name="month" value="@ViewBag.Month" class="form-control" /></div>
    <div class="col-md-3">
        <label class="form-label">المجموعة</label>
        <select id="groupId" name="groupId" class="form-select">
            <option value="0">كل المجموعات</option>
            @foreach (var g in groups)
            {
                <option value="@g.Value" selected="@(g.Value == gid)">@g.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">الحالة</label>
        <select name="status" class="form-select">
            <option value="-1" selected="@(st == -1)">الكل</option>
            <option value="0" selected="@(st == 0)">غير مدفوعة</option>
            <option value="1" selected="@(st == 1)">مدفوعة جزئياً</option>
            <option value="2" selected="@(st == 2)">مدفوعة</option>
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-outline-primary">عرض</button></div>
    <div class="col-auto"><button type="button" class="btn btn-primary" onclick="generateInvoices()">إنشاء فواتير الشهر</button></div>
</form>

<div class="row mb-3">
    <div class="col-md-4"><div class="alert alert-light border mb-0">إجمالي المستحق: <strong>@Model.Sum(x => x.Amount - x.Discount).ToString("N2")</strong></div></div>
    <div class="col-md-4"><div class="alert alert-success mb-0">المحصّل: <strong>@Model.Sum(x => x.Paid).ToString("N2")</strong></div></div>
    <div class="col-md-4"><div class="alert alert-danger mb-0">المتبقي: <strong>@Model.Sum(x => x.Remaining).ToString("N2")</strong></div></div>
</div>

<table class="table table-striped table-hover align-middle">
    <thead><tr><th>الطالب</th><th>المجموعة</th><th>المبلغ</th><th>الخصم</th><th>المدفوع</th><th>المتبقي</th><th>الحالة</th><th></th></tr></thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.StudentName</td>
                <td>@r.GroupName</td>
                <td>@r.Amount.ToString("N2")</td>
                <td>@r.Discount.ToString("N2")</td>
                <td>@r.Paid.ToString("N2")</td>
                <td>@r.Remaining.ToString("N2")</td>
                <td>
                    @switch (r.Status)
                    {
                        case InvoiceStatus.Paid:
                            <span class="badge bg-success">مدفوعة</span>
                            break;
                        case InvoiceStatus.PartiallyPaid:

                            <span class="badge bg-warning text-dark">جزئي</span>
                            break;
                        case InvoiceStatus.Waived:

                            <span class="badge bg-secondary">معفاة</span>
                            break;
                        default:

                            <span class="badge bg-danger">غير مدفوعة</span>
                            break;
                    }
                </td>
                <td><button class="btn btn-sm btn-outline-success" onclick="openForm('@Url.Action("Pay", "Invoices", new { id = r.Id })', 'تحصيل')">تحصيل</button></td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        function generateInvoices() {
            postJson('@Url.Action("Generate", "Invoices")',
                { month: $('#month').val(), groupId: $('#groupId').val() },
                function (r) { notify('success', r.message, function () { location.reload(); }); });
        }
    </script>
}