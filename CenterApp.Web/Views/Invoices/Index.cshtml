@model List<InvoiceRow>
@inject CenterApp.Service.Services.IPermissionService Perm

@{
    ViewData["Title"] = L.Get("Invoices.Title").Value;
    var groups = (List<SelectListItem>)ViewBag.Groups;
    var gid = ((long)ViewBag.GroupId).ToString();
    var st = (int)ViewBag.Status;
    var sort = (string)ViewBag.Sort;
    var search = (string)ViewBag.Search;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">@L.Get("Invoices.Title")</h3>
    @if (Perm.Has(User, Screens.Invoices, PermissionAction.Edit))
    {
        <button type="button" class="btn btn-outline-primary" onclick="recalcDiscounts()">
            <i class="bi bi-arrow-repeat"></i> @L.Get("Invoices.Recalculate")
        </button>
    }
</div>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-2">
        <label class="form-label">@L.Get("Invoices.Month")</label>
        <input type="month" name="month" value="@ViewBag.Month" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">@L.Get("Invoices.FullName")</label>
        <input type="search" name="q" value="@search" class="form-control" placeholder="@L.Get("Invoices.SearchName")" />
    </div>
    <div class="col-md-2">
        <label class="form-label">@L.Get("Common.Group")</label>
        <select name="groupId" class="form-select">
            <option value="0">@L.Get("Common.AllGroups")</option>
            @foreach (var g in groups)
            {
                <option value="@g.Value" selected="@(g.Value == gid)">@g.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">@L.Get("Invoices.PayStatus")</label>
        <select name="status" class="form-select">
            <option value="-1" selected="@(st == -1)">@L.Get("Common.All")</option>
            <option value="0" selected="@(st == 0)">@L.Get("Invoices.Unpaid")</option>
            <option value="1" selected="@(st == 1)">@L.Get("Invoices.Partial")</option>
            <option value="2" selected="@(st == 2)">@L.Get("Invoices.Paid")</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">@L.Get("Invoices.Sort")</label>
        <select name="sort" class="form-select">
            <option value="" selected="@(sort == "")">@L.Get("Common.Name")</option>
            <option value="balance-desc" selected="@(sort == "balance-desc")">@L.Get("Invoices.BalanceHigh")</option>
            <option value="balance-asc" selected="@(sort == "balance-asc")">@L.Get("Invoices.BalanceLow")</option>
            <option value="due-asc" selected="@(sort == "due-asc")">@L.Get("Invoices.DueSoon")</option>
            <option value="due-desc" selected="@(sort == "due-desc")">@L.Get("Invoices.DueLate")</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary">@L.Get("Invoices.Show")</button>
    </div>
</form>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <div class="alert alert-light border mb-0">@L.Get("Invoices.NetDue"): <strong>@Money(Model.Sum(x => x.NetDue))</strong></div>
    </div>
    <div class="col-md-4">
        <div class="alert alert-success mb-0">@L.Get("Invoices.TotalPaid"): <strong>@Money(Model.Sum(x => x.Paid))</strong></div>
    </div>
    <div class="col-md-4">
        <div class="alert alert-danger mb-0">@L.Get("Invoices.Remaining"): <strong>@Money(Model.Sum(x => x.Remaining))</strong></div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>@L.Get("Invoices.FullName")</th>
                <th>@L.Get("Common.Group")</th>
                <th>@L.Get("Invoices.Fee")</th>
                <th>@L.Get("Invoices.PermanentDiscount")</th>
                <th>@L.Get("Invoices.DiscountValue")</th>
                <th>@L.Get("Invoices.NetDue")</th>
                <th>@L.Get("Invoices.TotalPaid")</th>
                <th>@L.Get("Invoices.Remaining")</th>
                <th>@L.Get("Invoices.PayStatus")</th>
                <th>@L.Get("Invoices.DueDate")</th>
                <th>@L.Get("Invoices.LastPayment")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="12" class="text-muted text-center py-4">@L.Get("Invoices.Empty")</td></tr>
            }
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.StudentName</td>
                    <td>@r.GroupName</td>
                    <td>@Money(r.Amount)</td>
                    <td>@PermanentDiscount(r)</td>
                    <td>@Money(r.Discount)</td>
                    <td><strong>@Money(r.NetDue)</strong></td>
                    <td>@Money(r.Paid)</td>
                    <td>@Money(r.Remaining)</td>
                    <td>@StatusBadge(r.Status)</td>
                    <td class="text-nowrap">@r.DueDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-nowrap">@(r.LastPaymentDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    <td class="text-nowrap">
                        <div class="d-flex gap-1 flex-wrap">
                            @if (r.Remaining > 0)
                            {
                                <button type="button" class="btn btn-sm btn-outline-success"
                                        onclick="openForm('@Url.Action("Pay", "Invoices", new { id = r.Id })', '@L.Get("Invoices.RecordPayment")')">
                                    @L.Get("Invoices.RecordPayment")
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        onclick="openForm('@Url.Action("Pay", "Invoices", new { id = r.Id })', '@L.Get("Invoices.PaymentLog")')">
                                    @L.Get("Invoices.Log")
                                </button>
                            }

                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    onclick="openForm('@Url.Action("Discount", "Invoices", new { studentId = r.StudentId })', '@L.Get("Invoices.PermanentDiscount")', true)">
                                @L.Get("Invoices.Discount")
                            </button>

                            @if (r.Status != InvoiceStatus.Paid &&
                                 Perm.Has(User, Screens.Grace, PermissionAction.Add))
                            {
                                <button type="button" class="btn btn-sm btn-outline-warning"
                                        onclick="openForm('@Url.Action("Form", "Grace", new { studentId = r.StudentId, groupId = r.GroupId })', '@L.Get("Invoices.GraceTitle")')">
                                    @L.Get("Invoices.Grace")
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section Scripts {
    <script>
        function recalcDiscounts() {
            askConfirm(@Json.Serialize(L.Get("Invoices.RecalcAsk").Value), @Json.Serialize(L.Get("Invoices.RecalcYes").Value)).then(function (ok) {
                if (!ok) return;
                postJson('@Url.Action("RecalculateDiscounts", "Invoices")',
                    { month: '@ViewBag.Month', groupId: '@gid' },
                    function (r) { notify('success', r.message, function () { location.reload(); }); });
            });
        }
    </script>
}
@functions {
    string Money(decimal amount) => L.Get("Invoices.Egp", amount.ToString("N2")).Value;

    string PermanentDiscount(InvoiceRow r) => r.DiscountKind switch
    {
        DiscountKind.Percentage => $"{r.DiscountValue:0.##}%",
        DiscountKind.Fixed => Money(r.DiscountValue),
        _ => L.Get("Invoices.None").Value
    };

    Microsoft.AspNetCore.Html.IHtmlContent StatusBadge(InvoiceStatus status)
    {
        var (css, label) = status switch
        {
            InvoiceStatus.Paid => ("bg-success", L.Get("Invoices.Paid").Value),
            InvoiceStatus.PartiallyPaid => ("bg-warning text-dark", L.Get("Invoices.Partial").Value),
            InvoiceStatus.Waived => ("bg-secondary", L.Get("Invoices.Waived").Value),
            _ => ("bg-danger", L.Get("Invoices.Unpaid").Value)
        };
        return Html.Raw($@"<span class=""badge {css}"">{label}</span>");
    }
}
