@model InvoiceRow
@inject CenterApp.Application.Abstractions.IPermissionService Perm
@using System.Globalization
@functions {
    string MethodName(PaymentMethod m) => m == PaymentMethod.Cash ? L.Get("Pay.Cash").Value : m == PaymentMethod.Wallet ? L.Get("Pay.Wallet").Value : L.Get("Pay.Transfer").Value;
}
@{
    var inv = CultureInfo.InvariantCulture;
    var canDelete = Perm.Has(User, Screens.Invoices, PermissionAction.Delete);
    var payUrl = Url.Action("Pay", "Invoices", new { id = Model.Id });
}

<div class="mb-3">
    <div><strong>@Model.StudentName</strong> — @Model.GroupName</div>
    <div>@L.Get("Invoices.Invoice") @Model.Month/@Model.Year — @L.Get("Invoices.Amount"): @Model.Amount.ToString("N2") — @L.Get("Invoices.Discount"): @Model.Discount.ToString("N2") — @L.Get("Invoices.PaidSoFar"): @Model.Paid.ToString("N2") — <b>@L.Get("Invoices.Remaining"): @Model.Remaining.ToString("N2")</b></div>
</div>

@if (Model.Payments.Any())
{
    <h6>@L.Get("Invoices.Previous")</h6>
    <table class="table table-sm align-middle">
        <thead><tr><th>@L.Get("Invoices.Date")</th><th>@L.Get("Invoices.Amount")</th><th>@L.Get("Invoices.Method")</th><th>@L.Get("Common.Notes")</th><th></th></tr></thead>
        <tbody>
            @foreach (var p in Model.Payments)
            {
                <tr class="pay-row" data-id="@p.Id" data-date="@p.PaidAt.ToString("yyyy-MM-dd")"
                    data-amount="@p.Amount.ToString("0.##", inv)" data-method="@((int)p.Method)" data-note="@p.Note" data-note-en="@p.NoteEn">
                    <td class="c-date">@p.PaidAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="c-amount">@p.Amount.ToString("N2")</td>
                    <td class="c-method">@MethodName(p.Method)</td>
                    <td class="c-note">@Bilingual.Show(p.Note, p.NoteEn)</td>
                    <td class="c-act text-nowrap">
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="editPay(this)">@L.Get("Common.Edit")</button>
                        @if (canDelete)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="delPay(@p.Id)">@L.Get("Common.Delete")</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <hr />
}

<h6>@L.Get("Invoices.NewCollection")</h6>
<form id="payForm" onsubmit="return false;">
    <input type="hidden" name="invoiceId" value="@Model.Id" />
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">@L.Get("Invoices.Discount")</label>
            <input name="discount" type="number" min="0" step="0.01" class="form-control" value="@Model.Discount.ToString("0.##", inv)" />
        </div>
        <div class="col-md-4">
            <label class="form-label">@L.Get("Invoices.AmountNow", Model.Remaining.ToString("N2"))</label>
            <input name="amount" type="number" min="0" step="0.01" class="form-control" value="@Model.Remaining.ToString("0.##", inv)" />
        </div>
        <div class="col-md-4">
            <label class="form-label">@L.Get("Invoices.PayMethod")</label>
            <select name="method" class="form-select">
                <option value="0">@L.Get("Pay.Cash")</option>
                <option value="1">@L.Get("Pay.Wallet")</option>
                <option value="2">@L.Get("Pay.Transfer")</option>
            </select>
        </div>
        <div class="col-md-6"><label class="form-label">@L.Get("Common.Notes") (@L.Get("Common.InArabic"))</label><input name="note" class="form-control" /></div>
        <div class="col-md-6"><label class="form-label">@L.Get("Common.Notes") (@L.Get("Common.InEnglish"))</label><input name="noteEn" class="form-control" dir="ltr" /></div>
        <div class="col-12"><button class="btn btn-success" onclick="submitForm('#payForm', '@Url.Action("Pay", "Invoices")')">@L.Get("Invoices.SaveCollection")</button></div>
    </div>
</form>

<script>
    var payUrl = '@payUrl';
    function reopenPay() { openForm(payUrl, @Json.Serialize(L.Get("Invoices.ShortTitle").Value)); }

    // أي تعديل بيتعمل جوه النافذة، فنحدّث الصفحة اللي ورا لما النافذة تتقفل
    $('#appModal').off('hidden.bs.modal.pay').one('hidden.bs.modal.pay', function () { location.reload(); });

    function editPay(btn) {
        var $r = $(btn).closest('tr');
        if ($r.hasClass('editing')) return;
        $r.addClass('editing');

        $r.find('.c-date').html('<input type="date" class="form-control form-control-sm e-date" max="@DateTime.Today.ToString("yyyy-MM-dd")">');
        $r.find('.c-amount').html('<input type="number" min="0.01" step="0.01" class="form-control form-control-sm e-amount">');
        $r.find('.c-method').html('<select class="form-select form-select-sm e-method"><option value="0">' + @Json.Serialize(L.Get("Pay.Cash").Value) + '</option><option value="1">' + @Json.Serialize(L.Get("Pay.Wallet").Value) + '</option><option value="2">' + @Json.Serialize(L.Get("Pay.Transfer").Value) + '</option></select>');
        $r.find('.c-note').html('<input class="form-control form-control-sm e-note mb-1" placeholder="' + @Json.Serialize(L.Get("Common.InArabic").Value) + '"><input class="form-control form-control-sm e-note-en" dir="ltr" placeholder="' + @Json.Serialize(L.Get("Common.InEnglish").Value) + '">');
        $r.find('.c-act').html('<button type="button" class="btn btn-sm btn-success" onclick="savePay(this)">' + @Json.Serialize(L.Get("Common.Save").Value) + '</button> <button type="button" class="btn btn-sm btn-light" onclick="reopenPay()">' + @Json.Serialize(L.Get("Common.Cancel").Value) + '</button>');

        $r.find('.e-date').val($r.attr('data-date'));
        $r.find('.e-amount').val($r.attr('data-amount'));
        $r.find('.e-method').val($r.attr('data-method'));
        $r.find('.e-note').val($r.attr('data-note') || '');
        $r.find('.e-note-en').val($r.attr('data-note-en') || '');
    }

    function savePay(btn) {
        var $r = $(btn).closest('tr');
        postJson('@Url.Action("UpdatePayment", "Invoices")', {
            id: $r.attr('data-id'),
            amount: $r.find('.e-amount').val(),
            paidAt: $r.find('.e-date').val(),
            method: $r.find('.e-method').val(),
            note: $r.find('.e-note').val(),
            noteEn: $r.find('.e-note-en').val()
        }, function (r) { notify('success', r.message, reopenPay); });
    }

    function delPay(id) {
        askConfirm(@Json.Serialize(L.Get("Invoices.DeletePayAsk").Value), @Json.Serialize(L.Get("Invoices.DeletePayYes").Value)).then(function (ok) {
            if (!ok) return;
            postJson('@Url.Action("DeletePayment", "Invoices")', { id: id }, function (r) { notify('success', r.message, reopenPay); });
        });
    }
</script>
