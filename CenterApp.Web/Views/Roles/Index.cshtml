@model List<RoleRow>
@inject CenterApp.Application.Abstractions.IPermissionService Perm
@{
    ViewData["Title"] = L.Get("Menu.Roles").Value;
    var canAdd = Perm.Has(User, Screens.Roles, PermissionAction.Add);
    var canEdit = Perm.Has(User, Screens.Roles, PermissionAction.Edit);
    var canDelete = Perm.Has(User, Screens.Roles, PermissionAction.Delete);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@L.Get("Menu.Roles")</h3>
    @if (canAdd)
    {
        <button class="btn btn-primary" onclick="openForm('@Url.Action("Form", "Roles")', '@L.Get("Roles.New")', true)">+ @L.Get("Roles.New")</button>
    }
</div>

<table class="table table-striped table-hover align-middle">
    <thead><tr><th>@L.Get("Users.Role")</th><th>@L.Get("Roles.UserCount")</th><th></th></tr></thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>
                    <strong>@r.Name</strong>
                    @if (r.IsAdmin)
                    {
                        <span class="badge bg-danger ms-2">@L.Get("Roles.AllPermissions")</span>
                    }
                </td>
                <td>@r.Users</td>
                <td class="text-nowrap">
                    @if (!r.IsAdmin)
                    {
                        if (canEdit)
                        {
                            <button class="btn btn-sm btn-outline-primary" onclick="openForm('@Url.Action("Form", "Roles", new { id = r.Id })', '@L.Get("Roles.Edit")', true)">@L.Get("Roles.Permissions")</button>
                        }
                        if (canDelete)
                        {
                            <button class="btn btn-sm btn-outline-danger" onclick="confirmPost('@Url.Action("Delete", "Roles")', { id: '@r.Id' }, '@L.Get("Roles.DeleteAsk", r.Name)')">@L.Get("Common.Delete")</button>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>