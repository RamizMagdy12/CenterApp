@model List<RoleRow>
@inject CenterApp.Service.Services.IPermissionService Perm
@{
    ViewData["Title"] = "الأدوار والصلاحيات";
    var canAdd = Perm.Has(User, Screens.Roles, PermissionAction.Add);
    var canEdit = Perm.Has(User, Screens.Roles, PermissionAction.Edit);
    var canDelete = Perm.Has(User, Screens.Roles, PermissionAction.Delete);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>الأدوار والصلاحيات</h3>
    @if (canAdd)
    {
        <button class="btn btn-primary" onclick="openForm('@Url.Action("Form", "Roles")', 'دور جديد', true)">+ دور جديد</button>
    }
</div>

<table class="table table-striped table-hover align-middle">
    <thead><tr><th>الدور</th><th>عدد المستخدمين</th><th></th></tr></thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>
                    <strong>@r.Name</strong>
                    @if (r.IsAdmin)
                    {
                        <span class="badge bg-danger ms-2">كل الصلاحيات</span>
                    }
                </td>
                <td>@r.Users</td>
                <td class="text-nowrap">
                    @if (!r.IsAdmin)
                    {
                        if (canEdit)
                        {
                            <button class="btn btn-sm btn-outline-primary" onclick="openForm('@Url.Action("Form", "Roles", new { id = r.Id })', 'تعديل دور', true)">الصلاحيات</button>
                        }
                        if (canDelete)
                        {
                            <button class="btn btn-sm btn-outline-danger" onclick="confirmPost('@Url.Action("Delete", "Roles")', { id: '@r.Id' }, 'حذف الدور @r.Name؟')">حذف</button>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>