@model DashboardVm
@using System.Text.Json
@using CenterApp.Entity.Security
@inject CenterApp.Service.Services.IPermissionService Perm

@{
    ViewData["Title"] = L.Get("Menu.Dashboard").Value;

    var ui = CultureInfo.CurrentUICulture;
    var gradesTotal = Model.Grades.Sum(g => g.Count);
    var colors = new[] { "#163044", "#146278", "#2d8a99", "#5d7a8c", "#9fd0d6", "#d5e8eb" };
    var userName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";
    var hasAtt = Model.Last7.Any(d => d.Rate.HasValue);
    var collectedPct = Model.MonthDue > 0
        ? (int)Math.Round(100 * Model.MonthCollected / Model.MonthDue)
        : 0;
}

<div class="hello">
    <div class="avatar">
        @(string.IsNullOrEmpty(userName) ? L.Get("Common.UnknownMark").Value : userName.Substring(0, 1))
    </div>

    <div>
        <h2>@L.Get("Dash.Hello", userName)</h2>
        <p>@L.Get("Dash.Welcome")</p>
    </div>

    <div class="date-pill">
        <i class="bi bi-calendar3"></i>
        @DateTime.Now.ToString("dddd, dd MMMM yyyy", ui)
    </div>
</div>

<div class="stats">
    <div class="stat">
        <span class="pill pill-primary">
            @L.Get("Dash.Enrolled", Model.EnrolledStudents)
        </span>

        <div class="stat-ico dark">
            <i class="bi bi-people"></i>
        </div>

        <div class="stat-num">@Model.TotalStudents</div>
        <div class="stat-label">@L.Get("Dash.TotalStudents")</div>
    </div>

    <div class="stat">
        @if (Model.TodayPresentRate.HasValue)
        {
            <span class="pill pill-ok">
                @L.Get("Dash.TodaySessions", Model.TodaySessionsCount)
            </span>
        }
        else
        {
            <span class="pill pill-warn">@L.Get("Dash.NoData")</span>
        }

        <div class="stat-ico light">
            <i class="bi bi-check2"></i>
        </div>

        <div class="stat-num">
            @(Model.TodayPresentRate.HasValue
                ? Model.TodayPresentRate + "%"
                : "—")
        </div>

        <div class="stat-label">@L.Get("Dash.TodayAttendance")</div>
    </div>

    <div class="stat">
        <span class="pill pill-primary">@L.Get("Dash.ActiveCount", Model.ActiveGroups)</span>

        <div class="stat-ico dark">
            <i class="bi bi-collection"></i>
        </div>

        <div class="stat-num">@Model.ActiveGroups</div>
        <div class="stat-label">@L.Get("Menu.Groups")</div>
    </div>

    <div class="stat">
        <span class="pill pill-primary">@L.Get("Dash.TeacherCount", Model.Teachers)</span>

        <div class="stat-ico light">
            <i class="bi bi-person-workspace"></i>
        </div>

        <div class="stat-num">@Model.Teachers</div>
        <div class="stat-label">@L.Get("Lookups.Teachers")</div>
    </div>
</div>

<div class="grid-2-1">
    <div class="panel">
        <h3>@L.Get("Dash.AttendanceOverview")</h3>
        <div class="sub">@L.Get("Dash.AttendanceSub")</div>

        @if (!hasAtt)
        {
            <div class="empty-note">@L.Get("Dash.NoAttendanceYet")</div>
        }

        <div class="chart-box">
            <canvas id="attChart"></canvas>
        </div>
    </div>

    <div class="panel">
        <h3>@L.Get("Dash.ByGrade")</h3>
        <div class="sub">@L.Get("Dash.ActiveStudents", gradesTotal)</div>

        @if (gradesTotal == 0)
        {
            <div class="empty-box">@L.Get("Dash.NoStudents")</div>
        }
        else
        {
            <div class="donut-wrap">
                <canvas id="gradeChart"></canvas>

                <div class="donut-center">
                    <div>
                        <b>@gradesTotal</b>
                        <span>@L.Get("Common.Total")</span>
                    </div>
                </div>
            </div>

            @for (var i = 0; i < Model.Grades.Count; i++)
            {
                var g = Model.Grades[i];

                <div class="legend-row">
                    <span class="legend-dot"
                          style="background:@colors[i % colors.Length]"></span>

                    <span>@g.Name</span>
                    <span class="cnt">@g.Count</span>

                    <span class="pct">
                        @((100.0 * g.Count / gradesTotal).ToString("0.0"))%
                    </span>
                </div>
            }
        }
    </div>
</div>

<div class="grid-3">
    <div class="panel">
        <h3>@L.Get("Dash.TodayClasses")</h3>
        <div class="sub">@L.Get("Dash.SessionCount", Model.TodaySessionsCount)</div>

        @if (Model.TodaySessions.Count == 0)
        {
            <div class="empty-box">
                @L.Get("Dash.NoSessionsToday")
                <br />
                <a href="@Url.Action("Index", "Sessions")">
                    @L.Get("Dash.GenerateMonth")
                </a>
            </div>
        }

        @foreach (var s in Model.TodaySessions)
        {
            <div class="row-item">
                <div class="row-time">
                    @s.Start.ToString(@"hh\:mm")
                </div>

                <div class="row-main">
                    <b>@s.GroupName</b>

                    <small>
                        @(s.Total == 0
                            ? L.Get("Dash.NotTaken").Value
                            : L.Get("Dash.PresentOf", s.Present, s.Total).Value)
                    </small>
                </div>

                @if (s.Status == SessionStatus.Done)
                {
                    <span class="pill pill-ok">@L.Get("Dash.Done")</span>
                }
                else
                {
                    <a class="pill pill-warn"
                       href="@Url.Action("Index", "Sessions")">
                        @L.Get("Dash.TakeAttendance")
                    </a>
                }
            </div>
        }
    </div>

    @* إظهار حسابات الشهر لأصحاب صلاحية عرض الفواتير فقط *@
    @if (Perm.Has(User, Screens.Invoices, PermissionAction.View))
    {
        <div class="panel">
            <h3>@L.Get("Dash.MonthAccounts")</h3>

            <div class="sub">
                @DateTime.Today.ToString("MMMM yyyy", ui)
            </div>

            <div class="fin-row">
                <span>@L.Get("Dash.Due")</span>
                <b>@Model.MonthDue.ToString("N2")</b>
            </div>

            <div class="fin-row">
                <span>@L.Get("Dash.Collected")</span>
                <b class="money">@Model.MonthCollected.ToString("N2")</b>
            </div>

            <div class="fin-row">
                <span>@L.Get("Dash.Remaining")</span>
                <b style="color:#c53030">
                    @Model.MonthRemaining.ToString("N2")
                </b>
            </div>

            <div class="progress-bar-x">
                <div style="width:@collectedPct%"></div>
            </div>

            <small class="text-muted">
                @L.Get("Dash.CollectedPct", collectedPct)
            </small>

            <div class="mt-3">
                <a class="btn btn-sm btn-outline-primary"
                   href="@Url.Action("Index", "Invoices")">
                    @L.Get("Menu.Invoices")
                </a>
            </div>
        </div>
    }

    @* إظهار آخر التحصيلات لأصحاب صلاحية عرض الفواتير فقط *@
    @if (Perm.Has(User, Screens.Invoices, PermissionAction.View))
    {
        <div class="panel">
            <h3>@L.Get("Dash.RecentPayments")</h3>

            <div class="sub">
                @L.Get("Dash.RecentCount", Model.RecentPayments.Count)
            </div>

            @if (Model.RecentPayments.Count == 0)
            {
                <div class="empty-box">@L.Get("Dash.NoPayments")</div>
            }

            @foreach (var p in Model.RecentPayments)
            {
                <div class="row-item">
                    <div class="mini-avatar">
                        @(string.IsNullOrEmpty(p.StudentName)
                            ? L.Get("Common.UnknownMark").Value
                            : p.StudentName.Substring(0, 1))
                    </div>

                    <div class="row-main">
                        <b>@p.StudentName</b>
                        <small>
                            @p.PaidAt.ToString("yyyy-MM-dd HH:mm")
                        </small>
                    </div>

                    <span class="money">
                        @p.Amount.ToString("N2")
                    </span>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/chart.js/dist/chart.umd.js"></script>

    <script>
        Chart.defaults.font.family = "'Cairo', Tahoma, sans-serif";
        Chart.defaults.color = '#6a7d8a';

        var last7 = @Html.Raw(JsonSerializer.Serialize(
                                    Model.Last7.Select(d => new { l = d.Label, r = d.Rate })
                    ));

        new Chart(document.getElementById('attChart'), {
            type: 'line',
            data: {
                labels: last7.map(function (d) {
                    return d.l;
                }),
                datasets: [{
                    data: last7.map(function (d) {
                        return d.r;
                    }),
                    borderColor: '#146278',
                    backgroundColor: 'rgba(20,98,120,.10)',
                    fill: true,
                    tension: .35,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#146278',
                    pointBorderWidth: 2,
                    pointRadius: 5,
                    spanGaps: true
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: {
                            label: function (c) {
                                return c.parsed.y == null
                                    ? @Json.Serialize(L.Get("Dash.NoChartData").Value)
                                    : c.parsed.y + '%';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        min: 0,
                        max: 100,
                        ticks: {
                            callback: function (v) {
                                return v + '%';
                            }
                        },
                        grid: {
                            color: '#e8eef1'
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });

        var grades = @Html.Raw(JsonSerializer.Serialize(
                                    Model.Grades.Select(g => new { n = g.Name, c = g.Count })
                    ));

        var gc = document.getElementById('gradeChart');

        if (gc) {
            new Chart(gc, {
                type: 'doughnut',
                data: {
                    labels: grades.map(function (g) {
                        return g.n;
                    }),
                    datasets: [{
                        data: grades.map(function (g) {
                            return g.c;
                        }),
                        backgroundColor: [
                            '#163044',
                            '#146278',
                            '#2d8a99',
                            '#5d7a8c',
                            '#9fd0d6',
                            '#d5e8eb'
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    cutout: '72%',
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });
        }
    </script>
}