@model List<GroupRow>
@{
    ViewData["Title"] = L.Get("Menu.Groups").Value;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@L.Get("Menu.Groups")</h3>
    <button class="btn btn-primary" onclick="openForm('@Url.Action("Form", "Groups")', '@L.Get("Groups.New")', true)">+ @L.Get("Groups.New")</button>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="@L.Get("Groups.Search")" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary">@L.Get("Common.Search")</button></div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead><tr><th>@L.Get("Common.Group")</th><th>@L.Get("Common.Teacher")</th><th>@L.Get("Common.Subject")</th><th>@L.Get("Common.Grade")</th><th>@L.Get("Groups.Schedule")</th><th>@L.Get("Groups.Fee")</th><th>@L.Get("Menu.Students")</th><th></th></tr></thead>
    <tbody>
        @foreach (var g in Model)
        {
            <tr class="@(g.IsActive ? "" : "table-secondary")">
                <td>
                    @g.Name
                    @if (string.IsNullOrEmpty(g.Code))
                    {
                        <span class="badge bg-danger ms-1">@L.Get("Groups.NoCode")</span>
                    }
                    else
                    {

                        <span class="badge bg-dark ms-1" dir="ltr">@g.Code</span>
                    }
                </td>
                <td>@g.Teacher</td>
                <td>@g.Subject</td>
                <td>@g.Grade</td>
                <td><small>@g.Schedule</small></td>
                <td>@g.Fee.ToString("N2")</td>
                <td>@g.Enrolled / @(g.Capacity == 0 ? "∞" : g.Capacity.ToString())</td>
                <td class="text-nowrap">
                    <button class="btn btn-sm btn-outline-success" onclick="openForm('@Url.Action("Manage", "Enrollments", new { groupId = g.Id })', '@L.Get("Groups.Students")', true)">@L.Get("Menu.Students")</button>
                    <a class="btn btn-sm btn-outline-dark" target="_blank" href="@Url.Action("Cards", "Students", new { groupId = g.Id })">@L.Get("Students.QrCards")</a>
                    <button class="btn btn-sm btn-outline-primary" onclick="openForm('@Url.Action("Form", "Groups", new { id = g.Id })', '@L.Get("Groups.Edit")', true)">@L.Get("Common.Edit")</button>
                    <button class="btn btn-sm btn-outline-danger" onclick="confirmPost('@Url.Action("Delete", "Groups")', { id: @g.Id }, '@L.Get("Common.ConfirmDelete")')">@L.Get("Common.Delete")</button>
                </td>
            </tr>
        }
    </tbody>
</table>