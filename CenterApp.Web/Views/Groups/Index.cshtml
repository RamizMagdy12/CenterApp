@model List<GroupRow>
@{
    ViewData["Title"] = "المجموعات";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>المجموعات</h3>
    <button class="btn btn-primary" onclick="openForm('@Url.Action("Form", "Groups")', 'مجموعة جديدة', true)">+ مجموعة جديدة</button>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="بحث باسم المجموعة" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary">بحث</button></div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead><tr><th>المجموعة</th><th>المدرس</th><th>المادة</th><th>المرحلة</th><th>المواعيد</th><th>السعر</th><th>الطلاب</th><th></th></tr></thead>
    <tbody>
        @foreach (var g in Model)
        {
            <tr class="@(g.IsActive ? "" : "table-secondary")">
                <td>@g.Name</td>
                <td>@g.Teacher</td>
                <td>@g.Subject</td>
                <td>@g.Grade</td>
                <td><small>@g.Schedule</small></td>
                <td>@g.Fee.ToString("N2")</td>
                <td>@g.Enrolled / @(g.Capacity == 0 ? "∞" : g.Capacity.ToString())</td>
                <td class="text-nowrap">
                    <button class="btn btn-sm btn-outline-success" onclick="openForm('@Url.Action("Manage", "Enrollments", new { groupId = g.Id })', 'طلاب المجموعة', true)">الطلاب</button>
                    <button class="btn btn-sm btn-outline-primary" onclick="openForm('@Url.Action("Form", "Groups", new { id = g.Id })', 'تعديل مجموعة', true)">تعديل</button>
                    <button class="btn btn-sm btn-outline-danger" onclick="confirmPost('@Url.Action("Delete", "Groups")', { id: @g.Id }, 'تأكيد الحذف؟')">حذف</button>
                </td>
            </tr>
        }
    </tbody>
</table>