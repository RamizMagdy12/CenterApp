@{
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
}
<form asp-controller="Account" asp-action="SetLanguage" method="post" class="lang-dd">
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    <details>
        <summary class="lang-current">
            <span class="lang-code">@(isAr ? "AR" : "EN")</span>
            <span class="tb-lang-name">@(isAr ? "العربية" : "English")</span>
            <i class="bi bi-chevron-down lang-chev"></i>
        </summary>
        <div class="lang-menu">
            <button type="submit" name="culture" value="en" class="lang-opt @(!isAr ? "on" : "")">
                <span class="lang-code">EN</span>
                <span>English</span>
                @if (!isAr)
                {
                    <i class="bi bi-check2"></i>
                }
            </button>
            <button type="submit" name="culture" value="ar-EG" class="lang-opt @(isAr ? "on" : "")">
                <span class="lang-code">AR</span>
                <span>@(isAr ? "العربية" : "Arabic")</span>
                @if (isAr)
                {
                    <i class="bi bi-check2"></i>
                }
            </button>
        </div>
    </details>
</form>
<script>
    document.addEventListener('click', function (e) {
        document.querySelectorAll('.lang-dd details[open]').forEach(function (d) {
            if (!d.contains(e.target)) d.removeAttribute('open');
        });
    });
</script>
