@model StudentAttendanceVm
@{
    string Badge(AttendanceStatus s) => s switch
    {
        AttendanceStatus.Present => "bg-success",
        AttendanceStatus.Absent => "bg-danger",
        AttendanceStatus.Excused => "bg-secondary",
        AttendanceStatus.Late => "bg-warning text-dark",
        _ => "bg-light"
    };
    string Label(AttendanceStatus s) => s switch
    {
        AttendanceStatus.Present => L.Get("Att.Present").Value,
        AttendanceStatus.Absent => L.Get("Att.Absent").Value,
        AttendanceStatus.Excused => L.Get("Att.Excused").Value,
        AttendanceStatus.Late => L.Get("Att.Late").Value,
        _ => ""
    };
    var rate = Model.Total == 0 ? 0 : (int)Math.Round(Model.Attended * 100.0 / Model.Total);
}

<div class="stats">
    <div class="stat"><div class="stat-num">@Model.Present</div><div class="stat-label">@L.Get("Att.Present")</div></div>
    <div class="stat"><div class="stat-num">@Model.Late</div><div class="stat-label">@L.Get("Att.Late")</div></div>
    <div class="stat"><div class="stat-num">@Model.Absent</div><div class="stat-label">@L.Get("Att.Absent")</div></div>
    <div class="stat"><div class="stat-num">@Model.Excused</div><div class="stat-label">@L.Get("Att.Excused")</div></div>
    <div class="stat"><div class="stat-num">@rate%</div><div class="stat-label">@L.Get("Students.AttendanceRate")</div></div>
</div>

<div class="panel">
    @if (Model.Rows.Count == 0)
    {
        <div class="empty-box">@L.Get("Students.NoAttendanceYet")</div>
    }
    else
    {
        <table class="table table-striped table-hover align-middle mb-0">
            <thead><tr><th>@L.Get("Sessions.Date")</th><th>@L.Get("Sessions.Day")</th><th>@L.Get("Common.Group")</th><th>@L.Get("Sessions.From")</th><th>@L.Get("Sessions.To")</th><th>@L.Get("Common.Status")</th><th>@L.Get("Students.Note")</th></tr></thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.Date.ToString("yyyy-MM-dd")</td>
                        <td>@ArabicDays.Name(r.Date.DayOfWeek)</td>
                        <td>@r.GroupName</td>
                        <td>@r.Start.ToString(@"hh\:mm")</td>
                        <td>@r.End.ToString(@"hh\:mm")</td>
                        <td><span class="badge @Badge(r.Status)">@Label(r.Status)</span></td>
                        <td><small class="text-muted">@r.Note</small></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
