@{
    var title = ViewData["Title"] as string ?? L.Get("Exam.Title");
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<!DOCTYPE html>
<html lang="@(isAr ? "ar" : "en")" dir="@(isAr ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - @L.Get("App.Name")</title>
    <partial name="_Favicon" />
    <link rel="stylesheet" href="~/lib/fontsource-cairo/400.css" />
    <link rel="stylesheet" href="~/lib/fontsource-cairo/600.css" />
    <link rel="stylesheet" href="~/lib/fontsource-cairo/700.css" />
    <link rel="stylesheet" href="~/lib/fontsource-cairo/800.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="exam-body">
    @RenderBody()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
