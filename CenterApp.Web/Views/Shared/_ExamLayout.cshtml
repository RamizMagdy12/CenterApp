@{
    var title = ViewData["Title"] as string ?? "الاختبار";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - السنتر</title>
    <link rel="stylesheet" href="~/lib/fontsource-cairo/400.css" />
    <link rel="stylesheet" href="~/lib/fontsource-cairo/600.css" />
    <link rel="stylesheet" href="~/lib/fontsource-cairo/700.css" />
    <link rel="stylesheet" href="~/lib/fontsource-cairo/800.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="exam-body">
    @RenderBody()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
