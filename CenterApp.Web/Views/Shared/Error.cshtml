@model ErrorViewModel
@{
    ViewData["Title"] = L.Get("Error.Title").Value;
}

<h1 class="text-danger">@L.Get("Error.Heading")</h1>
<h2 class="text-danger">@L.Get("Error.Body")</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@L.Get("Error.RequestId")</strong> <code>@Model.RequestId</code>
    </p>
}
