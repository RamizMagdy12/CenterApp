@using System.Security.Claims
@inject CenterApp.Service.Services.IPermissionService Perm
@functions {
    record MI(string Text, string C, string A, string Screen, string? Type = null);
    record MG(string Title, string Icon, MI[] Items);
}
@{
    var ctrl = ((ViewContext.RouteData.Values["controller"] as string) ?? "").ToLower();
    var typeQ = Context.Request.Query["type"].ToString().ToLower();
    var pageTitle = ViewData["Title"] as string ?? "لوحة التحكم";
    var userName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "";

    var allMenu = new[]
    {
        new MG("الطلاب", "bi-people-fill", new[] { new MI("قائمة الطلاب", "Students", "Index", Screens.Students) }),
        new MG("المجموعات", "bi-collection-fill", new[] { new MI("المجموعات والمواعيد", "Groups", "Index", Screens.Groups) }),
        new MG("الحضور", "bi-qr-code-scan", new[] { new MI("الحصص والتحضير", "Sessions", "Index", Screens.Sessions) }),
        new MG("الحسابات", "bi-cash-coin", new[] { new MI("الفواتير والتحصيل", "Invoices", "Index", Screens.Invoices) }),
        new MG("البيانات الأساسية", "bi-gear-fill", new[]
        {
            new MI("المدرسين", "Lookups", "Index", Screens.Lookups, "teachers"),
            new MI("المواد", "Lookups", "Index", Screens.Lookups, "subjects"),
            new MI("المراحل الدراسية", "Lookups", "Index", Screens.Lookups, "gradelevels")
        }),
        new MG("الإدارة", "bi-shield-lock-fill", new[]
        {
            new MI("المستخدمين", "Users", "Index", Screens.Users),
            new MI("الأدوار والصلاحيات", "Roles", "Index", Screens.Roles)
        })
    };

    // القايمة بتظهر الشاشات اللي المستخدم ليه صلاحية "عرض" عليها بس
    var menu = allMenu
        .Select(g => g with { Items = g.Items.Where(i => Perm.Has(User, i.Screen, PermissionAction.View)).ToArray() })
        .Where(g => g.Items.Length > 0)
        .ToArray();
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - السنتر</title>
    <link rel="stylesheet" href="~/lib/fontsource-cairo/400.css" />
    <link rel="stylesheet" href="~/lib/fontsource-cairo/600.css" />
    <link rel="stylesheet" href="~/lib/fontsource-cairo/700.css" />
    <link rel="stylesheet" href="~/lib/fontsource-cairo/800.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app">

    <aside class="sidebar" id="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-logo"><i class="bi bi-mortarboard-fill"></i></span>
            <span class="brand-name">السنتر</span>
        </a>

        <div class="sb-tools">
            <input id="sbSearch" type="text" placeholder="ابحث في كل الشاشات" autocomplete="off" />
            <button type="button" id="sbCollapseAll">طي الكل</button>
        </div>

        <nav>
            <a class="mi-home @(ctrl == "home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                <i class="bi bi-speedometer2"></i><span>لوحة التحكم</span>
            </a>

            @foreach (var g in menu)
            {
                var open = g.Items.Any(i => ctrl == i.C.ToLower());
                <div class="mg @(open ? "open" : "")">
                    <button type="button" class="mg-head">
                        <i class="bi @g.Icon mg-ico"></i>
                        <span class="mg-title">@g.Title</span>
                        <i class="bi bi-chevron-down chev"></i>
                    </button>
                    <div class="mg-items">
                        @foreach (var it in g.Items)
                        {
                            var active = ctrl == it.C.ToLower() && (it.Type == null || typeQ == it.Type);
                            <a class="mi @(active ? "active" : "")" href="@Url.Action(it.A, it.C, it.Type == null ? null : new { type = it.Type })">
                                <i class="bi bi-dot"></i><span>@it.Text</span>
                            </a>
                        }
                    </div>
                </div>
            }
        </nav>
    </aside>
    <div class="sb-overlay" id="sbOverlay"></div>

    <div class="main">
        <header class="topbar">
            <button type="button" class="tb-hamb" id="sbToggle" aria-label="القائمة"><i class="bi bi-list"></i></button>
            <div class="tb-title">
                <h1>@pageTitle</h1>
                <div class="crumbs"><a asp-controller="Home" asp-action="Index">الرئيسية</a> / @pageTitle</div>
            </div>

            <div class="tb-right">
                <div class="tb-dd">
                    <button type="button" class="tb-icon" data-pop="popBell"><i class="bi bi-bell"></i></button>
                    <div class="tb-pop" id="popBell">
                        <div class="tb-pop-title">الإشعارات</div>
                        <div class="tb-pop-empty">مفيش إشعارات جديدة</div>
                    </div>
                </div>

                <div class="tb-lang"><span class="lang-code">AR</span> العربية</div>

                <div class="tb-dd">
                    <button type="button" class="tb-user" data-pop="popUser">
                        <div class="tb-user-txt">
                            <div class="tb-user-name">@userName</div>
                            <div class="tb-user-role">@userRole</div>
                        </div>
                        <div class="avatar">@(userName.Length > 0 ? userName.Substring(0, 1) : "؟")</div>
                    </button>
                    <div class="tb-pop" id="popUser" style="width:200px">
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-outline-danger w-100"><i class="bi bi-box-arrow-right"></i> تسجيل الخروج</button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        <main class="content">
            @RenderBody()
        </main>
    </div>

    <div class="modal fade" id="appModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-scrollable" id="appModalDialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="appModalTitle"></h5>
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="appModalBody"></div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/dist/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>