<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - السنتر</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">السنتر</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav gap-lg-2">
                    <li class="nav-item"><a class="nav-link" asp-controller="Students" asp-action="Index">الطلاب</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Groups" asp-action="Index">المجموعات</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Sessions" asp-action="Index">الحصص والحضور</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Invoices" asp-action="Index">الفواتير والتحصيل</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">البيانات الأساسية</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Lookups" asp-action="Index" asp-route-type="teachers">المدرسين</a></li>
                            <li><a class="dropdown-item" asp-controller="Lookups" asp-action="Index" asp-route-type="subjects">المواد</a></li>
                            <li><a class="dropdown-item" asp-controller="Lookups" asp-action="Index" asp-route-type="gradelevels">المراحل الدراسية</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container-fluid px-4">
        @RenderBody()
    </main>

    <div class="modal fade" id="appModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-scrollable" id="appModalDialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="appModalTitle"></h5>
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="appModalBody"></div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>