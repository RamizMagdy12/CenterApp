@using System.Security.Claims
@inject CenterApp.Service.Services.IPermissionService Perm
@functions {
    record MI(string Text, string C, string A, string Screen, string? Type = null, string? Act = null);
    record MG(string Title, string Icon, MI[] Items);
}
@{
    var ctrl = ((ViewContext.RouteData.Values["controller"] as string) ?? "").ToLower();
    var action = ((ViewContext.RouteData.Values["action"] as string) ?? "").ToLower();
    if (action == "edit") action = "index";
    var typeQ = Context.Request.Query["type"].ToString().ToLower();
    var pageTitle = ViewData["Title"] as string ?? L.Get("Menu.Dashboard");
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var userName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";
    var userRoleRaw = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var userRole = userRoleRaw switch
    {
        RoleNames.Admin => L.Get("Role.Admin").Value,
        RoleNames.Teacher => L.Get("Role.Teacher").Value,
        RoleNames.Student => L.Get("Role.Student").Value,
        _ => userRoleRaw
    };

    var allMenu = new[]
    {
        new MG(L.Get("Menu.Students"), "bi-people-fill", new[] { new MI(L.Get("Menu.StudentList"), "Students", "Index", Screens.Students) }),
        new MG(L.Get("Menu.Messages"), "bi-chat-dots-fill", new[] { new MI(L.Get("Menu.StudentQuestions"), "Messages", "Index", Screens.Messages) }),
        new MG(L.Get("Menu.Groups"), "bi-collection-fill", new[] { new MI(L.Get("Menu.GroupsSchedule"), "Groups", "Index", Screens.Groups) }),
        new MG(L.Get("Menu.Attendance"), "bi-qr-code-scan", new[] { new MI(L.Get("Menu.Sessions"), "Sessions", "Index", Screens.Sessions) }),
        new MG(L.Get("Menu.Content"), "bi-collection-play-fill", new[]
        {
            new MI(L.Get("Menu.Materials"), "Materials", "Index", Screens.Materials),
            new MI(L.Get("Menu.Homework"), "Homeworks", "Index", Screens.Homework)
        }),
        new MG(L.Get("Menu.Exams"), "bi-patch-question-fill", new[]
        {
            new MI(L.Get("Menu.OnlineExams"), "Exams", "Index", Screens.Exams, null, "Index"),
            new MI(L.Get("Menu.OnlineGrades"), "Exams", "Grades", Screens.Exams, null, "Grades"),
            new MI(L.Get("Menu.OfflineGrades"), "OfflineExams", "Index", Screens.Exams, null, "Index")
        }),
        new MG(L.Get("Menu.Reports"), "bi-file-earmark-text", new[] { new MI(L.Get("Menu.StudentReports"), "Reports", "Index", Screens.Reports) }),
        new MG(L.Get("Menu.Accounts"), "bi-cash-coin", new[]
        {
            new MI(L.Get("Menu.Invoices"), "Invoices", "Index", Screens.Invoices),
            new MI(L.Get("Menu.Grace"), "Grace", "Index", Screens.Grace)
        }),
        new MG(L.Get("Menu.Lookups"), "bi-gear-fill", new[]
        {
            new MI(L.Get("Lookups.Teachers"), "Lookups", "Index", Screens.Lookups, "teachers"),
            new MI(L.Get("Lookups.Subjects"), "Lookups", "Index", Screens.Lookups, "subjects"),
            new MI(L.Get("Lookups.Grades"), "Lookups", "Index", Screens.Lookups, "gradelevels")
        }),
        new MG(L.Get("Menu.Admin"), "bi-shield-lock-fill", new[]
        {
            new MI(L.Get("Menu.Users"), "Users", "Index", Screens.Users),
            new MI(L.Get("Menu.Roles"), "Roles", "Index", Screens.Roles)
        })

    };

    // القايمة بتظهر الشاشات اللي المستخدم ليه صلاحية "عرض" عليها بس
    var menu = allMenu
        .Select(g => g with { Items = g.Items.Where(i => Perm.Has(User, i.Screen, PermissionAction.View)).ToArray() })
        .Where(g => g.Items.Length > 0)
        .ToArray();
}
<!DOCTYPE html>
<html lang="@(isAr ? "ar" : "en")" dir="@(isAr ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - @L.Get("App.Name")</title>
    <partial name="_Favicon" />
    <link rel="stylesheet" href="~/lib/fontsource-cairo/400.css" />
    <link rel="stylesheet" href="~/lib/fontsource-cairo/600.css" />
    <link rel="stylesheet" href="~/lib/fontsource-cairo/700.css" />
    <link rel="stylesheet" href="~/lib/fontsource-cairo/800.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app">

    <aside class="sidebar" id="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-logo"><i class="bi bi-mortarboard-fill"></i></span>
            <span class="brand-name">@L.Get("App.Name")</span>
        </a>

        <div class="sb-tools">
            <input id="sbSearch" type="text" placeholder="@L.Get("Menu.Search")" autocomplete="off" />
            <button type="button" id="sbCollapseAll">@L.Get("Menu.CollapseAll")</button>
        </div>

        <nav>
            <a class="mi-home @(ctrl == "home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                <i class="bi bi-speedometer2"></i><span>@L.Get("Menu.Dashboard")</span>
            </a>

            @foreach (var g in menu)
            {
                var open = g.Items.Any(i => ctrl == i.C.ToLower());
                <div class="mg @(open ? "open" : "")">
                    <button type="button" class="mg-head">
                        <i class="bi @g.Icon mg-ico"></i>
                        <span class="mg-title">@g.Title</span>
                        <i class="bi bi-chevron-down chev"></i>
                    </button>
                    <div class="mg-items">
                        @foreach (var it in g.Items)
                        {
                            var active = ctrl == it.C.ToLower() && (it.Type == null || typeQ == it.Type) && (it.Act == null || action == it.Act.ToLower());
                            <a class="mi @(active ? "active" : "")" href="@Url.Action(it.A, it.C, it.Type == null ? null : new { type = it.Type })">
                                <i class="bi bi-dot"></i><span>@it.Text</span>
                            </a>
                        }
                    </div>
                </div>
            }
        </nav>
    </aside>
    <div class="sb-overlay" id="sbOverlay"></div>

    <div class="main">
        <header class="topbar">
            <button type="button" class="tb-hamb" id="sbToggle" aria-label="@L.Get("Common.Menu")"><i class="bi bi-list"></i></button>
            <div class="tb-title">
                <h1>@pageTitle</h1>
                <div class="crumbs"><a asp-controller="Home" asp-action="Index">@L.Get("Common.Home")</a> / @pageTitle</div>
            </div>

            <div class="tb-right">
                <partial name="_NotifyBell" />

                <partial name="_LangSwitch" />

                <div class="tb-dd">
                    <button type="button" class="tb-user" data-pop="popUser">
                        <div class="tb-user-txt">
                            <div class="tb-user-name">@userName</div>
                            <div class="tb-user-role">@userRole</div>
                        </div>
                        <div class="avatar">@(userName.Length > 0 ? userName.Substring(0, 1) : L.Get("Common.UnknownMark").Value)</div>
                    </button>
                    <div class="tb-pop" id="popUser" style="width:200px">
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-outline-danger w-100"><i class="bi bi-box-arrow-right"></i> @L.Get("Auth.Logout")</button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        <main class="content">
            @RenderBody()
        </main>
    </div>

    <div class="modal fade" id="appModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down" id="appModalDialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="appModalTitle"></h5>
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="appModalBody"></div>
            </div>
        </div>
    </div>

    <partial name="_L10n" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/dist/sweetalert2.all.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>