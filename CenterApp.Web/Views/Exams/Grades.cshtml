@model OnlineGradesVm
@inject CenterApp.Service.Services.IPermissionService Perm
@{
    ViewData["Title"] = L.Get("Menu.OnlineGrades").Value;
    var canEdit = Perm.Has(User, Screens.Exams, PermissionAction.Edit);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@L.Get("Exam.OnlineGradesTitle")</h3>
    <a class="btn btn-light" asp-action="Index">@L.Get("Menu.Exams")</a>
</div>

@if (Model.Exams.Count == 0)
{
    <div class="panel empty-box">@L.Get("Exam.NoExamsForGrades")</div>
}
else
{
    <div class="panel mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label">@L.Get("Exam.Title")</label>
                <select class="form-select" onchange="location = '@Url.Action("Grades", "Exams")?id=' + this.value">
                    @foreach (var e in Model.Exams)
                    {
                        <option value="@e.Id" selected="@(e.Id == Model.ExamId)">@e.Title — @e.OpensAt.ToString("yyyy-MM-dd HH:mm")</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <div><strong>@Model.Title</strong></div>
                <div class="text-muted small">@Model.Groups</div>
                <div class="text-muted small">@L.Get("Exam.WindowScore", Model.OpensAt.ToString("yyyy-MM-dd HH:mm"), Model.ClosesAt.ToString("yyyy-MM-dd HH:mm"), Model.MaxScore.ToString("0.##"))</div>
                @if (Model.ResultsVisible)
                {
                    <span class="badge bg-success">@L.Get("Exam.StudentsSeeResults")</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">@L.Get("Exam.ResultsOn", Model.ResultsAt.ToString("yyyy-MM-dd HH:mm"))</span>
                }
            </div>
        </div>
    </div>

    @if (Model.Rows.Count == 0)
    {
        <div class="alert alert-warning">@L.Get("Exam.NoStudents")</div>
    }
    else
    {
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>@L.Get("Common.Code")</th>
                    <th>@L.Get("Common.Student")</th>
                    <th>@L.Get("Common.Status")</th>
                    <th>@L.Get("Exam.SubmittedAt")</th>
                    <th>@L.Get("Exam.Score")</th>
                    <th>@L.Get("Exam.Violations")</th>
                    @if (canEdit)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td class="text-muted">@r.StudentCode</td>
                        <td>@r.StudentName</td>
                        <td>@r.StatusText</td>
                        <td>@(r.SubmittedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td>
                            @if (r.Score == null)
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <strong>@r.Score.Value.ToString("0.##")</strong>
                                <span class="text-muted">/ @Model.MaxScore.ToString("0.##")</span>
                            }
                        </td>
                        <td>
                            @if (r.Violations > 0)
                            {
                                <span class="badge bg-danger">@r.Violations</span>
                                <small class="text-muted">@r.EndReason</small>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        @if (canEdit)
                        {
                            <td>
                                @if (r.CanReopen)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary btn-reopen" data-exam="@Model.ExamId" data-student="@r.StudentId" data-name="@r.StudentName">@L.Get("Exam.Reopen")</button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
}

@section Scripts {
    <script>
        var reopenFor = @Json.Serialize(L.Get("Exam.ReopenFor").Value);
        var minutesLabel = @Json.Serialize(L.Get("Exam.Minutes").Value);
        var openNow = @Json.Serialize(L.Get("Exam.OpenNow").Value);
        var backLabel = @Json.Serialize(L.Get("Exam.Back").Value);
        var minutesRange = @Json.Serialize(L.Get("Exam.MinutesRange").Value);
        document.querySelectorAll('.btn-reopen').forEach(function (btn) {
            btn.onclick = function () {
                var name = btn.getAttribute('data-name') || '';
                Swal.fire({
                    title: reopenFor.replace('{0}', name),
                    input: 'number',
                    inputLabel: minutesLabel,
                    inputValue: 30,
                    inputAttributes: { min: 5, max: 360, step: 5 },
                    showCancelButton: true,
                    confirmButtonText: openNow,
                    cancelButtonText: backLabel,
                    heightAuto: false,
                    inputValidator: function (v) {
                        var n = parseInt(v, 10);
                        if (!n || n < 5 || n > 360) return minutesRange;
                    }
                }).then(function (r) {
                    if (!r.isConfirmed) return;
                    postJson('@Url.Action("Reopen", "Exams")', {
                        examId: btn.getAttribute('data-exam'),
                        studentId: btn.getAttribute('data-student'),
                        minutes: parseInt(r.value, 10)
                    }, function () { location.reload(); });
                });
            };
        });
    </script>
}
