@model OnlineExamEditVm
@using System.Text.Json
@{
    ViewData["Title"] = Model.Id == 0 ? L.Get("Exam.NewOnline").Value : L.Get("Exam.EditTitle").Value;
    var qjson = JsonSerializer.Serialize(Model.Questions, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}
<div class="panel">
    <div class="row g-3">
        <div class="col-md-8">
            <label class="form-label">@L.Get("Exam.ExamTitle")</label>
            <input id="mTitle" class="form-control" value="@Model.Title" @(Model.Locked ? "disabled" : "") />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            @if (Model.Status == ExamStatus.Published)
            {
                <span class="badge bg-success">@L.Get("Exam.Published")</span>
            }
            else if (Model.Id != 0)
            {
                <span class="badge bg-secondary">@L.Get("Exam.Draft")</span>
            }
        </div>
        <div class="col-12">
            <label class="form-label">@L.Get("Exam.StudentDescription")</label>
            <textarea id="mDesc" class="form-control" rows="2" @(Model.Locked ? "disabled" : "")>@Model.Description</textarea>
        </div>
        <div class="col-md-4">
            <label class="form-label">@L.Get("Exam.OpensFrom")</label>
            <input id="mOpen" type="datetime-local" class="form-control" value="@Model.OpensAt?.ToString("yyyy-MM-ddTHH:mm")" @(Model.Locked ? "disabled" : "") />
        </div>
        <div class="col-md-4">
            <label class="form-label">@L.Get("Exam.ClosesAt")</label>
            <input id="mClose" type="datetime-local" class="form-control" value="@Model.ClosesAt?.ToString("yyyy-MM-ddTHH:mm")" @(Model.Locked ? "disabled" : "") />
        </div>
        <div class="col-md-4">
            <label class="form-label">@L.Get("Exam.ResultsAtLabel")</label>
            <input id="mResult" type="datetime-local" class="form-control" value="@Model.ResultsAt?.ToString("yyyy-MM-ddTHH:mm")" />
        </div>
        <div class="col-12">
            <div class="alert alert-info mb-0">
                @L.Get("Exam.Rules")
            </div>
        </div>
        @if (Model.Locked)
        {
            <div class="col-12">
                <div class="alert alert-warning mb-0">@L.Get("Exam.LockedHint")</div>
            </div>
        }

        <div class="col-12">
            <label class="form-label">@L.Get("Exam.Groups")</label>
            <div class="form-check mb-1">
                <input type="checkbox" class="form-check-input" id="gAll" @(Model.Locked ? "disabled" : "") />
                <label for="gAll" class="form-check-label fw-bold">@L.Get("Common.AllGroups")</label>
            </div>
            <div class="border rounded p-2" style="max-height:200px;overflow:auto">
                @if (Model.Groups.Count == 0)
                {
                    <span class="text-muted">@L.Get("Exam.NoGroups")</span>
                }
                @foreach (var g in Model.Groups)
                {
                    <div class="form-check">
                        <input class="form-check-input g-chk" type="checkbox" id="g_@g.Id" value="@g.Id" @(g.Selected ? "checked" : "") @(Model.Locked ? "disabled" : "") />
                        <label class="form-check-label" for="g_@g.Id">@g.Name</label>
                    </div>
                }
            </div>
        </div>

        <div class="col-12 d-flex justify-content-between align-items-center">
            <label class="form-label mb-0">@L.Get("Exam.Questions") <span class="text-muted" id="totalPts"></span></label>
            @if (!Model.Locked)
            {
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="addQuestion()">+ @L.Get("Exam.Question")</button>
            }
        </div>
        <div class="col-12" id="qList"></div>

        <div class="col-12 d-flex gap-2">
            @if (!Model.Locked)
            {
                <button class="btn btn-outline-primary" id="btnDraft" onclick="saveAll(false)">@L.Get("Exam.SaveDraft")</button>
                <button class="btn btn-success" id="btnPub" onclick="saveAll(true)">@L.Get("Exam.SavePublish")</button>
            }
            else
            {
                <button class="btn btn-primary" id="btnDraft" onclick="saveAll(false)">@L.Get("Exam.SaveResultsTime")</button>
            }
            <a class="btn btn-light" asp-action="Index">@L.Get("Exam.Back")</a>
        </div>
    </div>
</div>
<script type="application/json" id="qSeed">@Html.Raw(qjson)</script>

@section Scripts {
    <script>
        var examId = @Model.Id;
        var locked = @(Model.Locked ? "true" : "false");
        var questions = JSON.parse(document.getElementById('qSeed').textContent || '[]');
        var lblQuestionImage = @Json.Serialize(L.Get("Exam.QuestionImage").Value);
        var lblRemoveImage = @Json.Serialize(L.Get("Exam.RemoveImage").Value);
        var lblImageTooBig = @Json.Serialize(L.Get("Exam.ImageTooBig").Value);
        var lblTotal = @Json.Serialize(L.Get("Exam.TotalPoints").Value);
        var lblChoice = @Json.Serialize(L.Get("Exam.Choice").Value);
        var lblDelete = @Json.Serialize(L.Get("Common.Delete").Value);
        var lblQuestionN = @Json.Serialize(L.Get("Exam.QuestionN").Value);
        var lblDeleteQuestion = @Json.Serialize(L.Get("Exam.DeleteQuestion").Value);
        var lblQuestionText = @Json.Serialize(L.Get("Exam.QuestionTextPh").Value);
        var lblQuestionPoints = @Json.Serialize(L.Get("Exam.QuestionPoints").Value);
        var lblMarkCorrect = @Json.Serialize(L.Get("Exam.MarkCorrect").Value);
        var lblAddChoice = @Json.Serialize(L.Get("Exam.Choice").Value);
        var lblTitleRequired = @Json.Serialize(L.Get("Exam.TitleRequired").Value);
        var lblScheduleRequired = @Json.Serialize(L.Get("Exam.ScheduleRequired").Value);
        var lblGroupRequired = @Json.Serialize(L.Get("Exam.GroupRequired").Value);
        var lblResultsRequired = @Json.Serialize(L.Get("Exam.ResultsRequired").Value);
        var lblImageFailed = @Json.Serialize(L.Get("Exam.ImageUploadFailed").Value);
        var lblPublished = @Json.Serialize(L.Get("Common.Published").Value);
        var lblSaved = @Json.Serialize(L.Get("Common.Saved").Value);
        var lblTryAgain = @Json.Serialize(L.Get("Exam.TryAgain").Value);

        $('#gAll').on('change', function () { $('.g-chk').prop('checked', this.checked); });
        $('.g-chk').on('change', function () { $('#gAll').prop('checked', $('.g-chk').length > 0 && $('.g-chk').length === $('.g-chk:checked').length); });
        $('#gAll').prop('checked', $('.g-chk').length > 0 && $('.g-chk').length === $('.g-chk:checked').length);

        function esc(s) { return $('<i>').text(s || '').html(); }

        function imageBox(q, qi) {
            var html = '<div class="mb-2">';
            if (q.file) html += '<img alt="" style="max-width:220px;max-height:160px;border-radius:8px;display:block;margin-bottom:8px" src="' + URL.createObjectURL(q.file) + '" />';
            else if (q.imageStoredName) html += '<img alt="" style="max-width:220px;max-height:160px;border-radius:8px;display:block;margin-bottom:8px" src="@Url.Action("QuestionImage", "Exams")?examId=' + examId + '&name=' + encodeURIComponent(q.imageStoredName) + '" />';
            if (!locked) {
                html += '<label class="btn btn-sm btn-outline-secondary mb-0">' + esc(lblQuestionImage) + '<input type="file" accept="image/png,image/jpeg,image/webp,image/gif" hidden onchange="pickImage(' + qi + ', this)" /></label> ';
                if (q.imageStoredName || q.file) html += '<button type="button" class="btn btn-sm btn-outline-danger" onclick="clearImage(' + qi + ')">' + esc(lblRemoveImage) + '</button>';
            }
            return html + '</div>';
        }

        function pickImage(qi, input) {
            var f = input.files && input.files[0];
            if (!f) return;
            if (f.size > 4 * 1024 * 1024) {
                notify('warning', lblImageTooBig);
                return;
            }
            questions[qi].file = f;
            render();
        }

        function clearImage(qi) {
            questions[qi].file = null;
            questions[qi].imageStoredName = '';
            render();
        }

        function addQuestion() {
            questions.push({ text: '', points: 1, choices: [{ text: '', isCorrect: true }, { text: '', isCorrect: false }] });
            render();
        }

        function render() {
            var total = questions.reduce(function (s, q) { return s + (parseFloat(q.points) || 0); }, 0);
            $('#totalPts').text(questions.length ? lblTotal.replace('{0}', total) : '');
            $('#qList').html(questions.map(function (q, qi) {
                var choices = (q.choices || []).map(function (c, ci) {
                    return '<div class="d-flex gap-2 align-items-center mb-2">' +
                        '<input type="radio" name="ok_' + qi + '" ' + (c.isCorrect ? 'checked' : '') + (locked ? ' disabled' : '') + ' onchange="markCorrect(' + qi + ',' + ci + ')" />' +
                        '<input class="form-control" placeholder="' + esc(lblChoice) + '" value="' + esc(c.text) + '" ' + (locked ? 'disabled' : '') + ' oninput="questions[' + qi + '].choices[' + ci + '].text=this.value" />' +
                        (locked ? '' : '<button type="button" class="btn btn-sm btn-outline-danger" onclick="removeChoice(' + qi + ',' + ci + ')">' + esc(lblDelete) + '</button>') +
                        '</div>';
                }).join('');
                return '<div class="border rounded p-3 mb-3">' +
                    '<div class="d-flex justify-content-between mb-2"><strong>' + esc(lblQuestionN.replace('{0}', qi + 1)) + '</strong>' +
                    (locked ? '' : '<button type="button" class="btn btn-sm btn-outline-danger" onclick="questions.splice(' + qi + ',1);render()">' + esc(lblDeleteQuestion) + '</button>') +
                    '</div>' +
                    '<textarea class="form-control mb-2" rows="2" placeholder="' + esc(lblQuestionText) + '" ' + (locked ? 'disabled' : '') + ' oninput="questions[' + qi + '].text=this.value">' + esc(q.text) + '</textarea>' +
                    imageBox(q, qi) +
                    '<div class="row g-2 mb-2"><div class="col-md-3"><label class="form-label">' + esc(lblQuestionPoints) + '</label>' +
                    '<input type="number" min="0.5" step="0.5" class="form-control" value="' + (q.points || 1) + '" ' + (locked ? 'disabled' : '') + ' oninput="questions[' + qi + '].points=parseFloat(this.value)||0;renderTotal()" /></div></div>' +
                    '<div class="small text-muted mb-1">' + esc(lblMarkCorrect) + '</div>' + choices +
                    (locked ? '' : '<button type="button" class="btn btn-sm btn-outline-secondary" onclick="addChoice(' + qi + ')">+ ' + esc(lblAddChoice) + '</button>') +
                    '</div>';
            }).join(''));
        }

        function renderTotal() {
            var total = questions.reduce(function (s, q) { return s + (parseFloat(q.points) || 0); }, 0);
            $('#totalPts').text(questions.length ? lblTotal.replace('{0}', total) : '');
        }

        function markCorrect(qi, ci) {
            questions[qi].choices.forEach(function (c, i) { c.isCorrect = i === ci; });
        }
        function addChoice(qi) {
            questions[qi].choices.push({ text: '', isCorrect: false });
            render();
        }
        function removeChoice(qi, ci) {
            questions[qi].choices.splice(ci, 1);
            if (!questions[qi].choices.some(function (c) { return c.isCorrect; }) && questions[qi].choices[0])
                questions[qi].choices[0].isCorrect = true;
            render();
        }

        function setBusy(b) { $('#btnDraft,#btnPub').prop('disabled', b); }

        function collectQuestions() {
            var list = [];
            $('#qList > .border').each(function (i) {
                var choices = [];
                $(this).find('.d-flex.gap-2').each(function () {
                    choices.push({
                        Text: $(this).find('input.form-control').val(),
                        IsCorrect: $(this).find('input[type=radio]').prop('checked')
                    });
                });
                var q = questions[i] || {};
                list.push({
                    Text: $(this).find('textarea').val(),
                    Points: parseFloat($(this).find('input[type=number]').val()) || 0,
                    ImageStoredName: q.file ? '' : (q.imageStoredName || ''),
                    Choices: choices
                });
            });
            return list;
        }

        async function saveAll(publish) {
            var title = $.trim($('#mTitle').val());
            var groups = $('.g-chk:checked').map(function () { return parseInt(this.value); }).get();
            if (!locked) {
                if (!title) return notify('warning', lblTitleRequired);
                if (!$('#mOpen').val() || !$('#mClose').val() || !$('#mResult').val()) return notify('warning', lblScheduleRequired);
                if (!groups.length) return notify('warning', lblGroupRequired);
            } else if (!$('#mResult').val()) {
                return notify('warning', lblResultsRequired);
            }
            setBusy(true);
            try {
                var res = await $.ajax({
                    url: '@Url.Action("Save", "Exams")', type: 'POST', contentType: 'application/json',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    data: JSON.stringify({
                        Id: examId,
                        Title: title,
                        Description: $('#mDesc').val(),
                        OpensAt: $('#mOpen').val(),
                        ClosesAt: $('#mClose').val(),
                        ResultsAt: $('#mResult').val(),
                        GroupIds: groups,
                        Questions: collectQuestions()
                    })
                });
                if (!res.ok) throw res.message;
                examId = res.id;
                for (var i = 0; i < questions.length; i++) {
                    if (!questions[i].file) continue;
                    var fd = new FormData();
                    fd.append('examId', examId);
                    fd.append('sortOrder', i);
                    fd.append('file', questions[i].file);
                    var up = await $.ajax({
                        url: '@Url.Action("QuestionImage", "Exams")',
                        type: 'POST', data: fd, processData: false, contentType: false,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    if (!up.ok) throw up.message || lblImageFailed;
                }
                if (publish) {
                    var p = await $.post('@Url.Action("Publish", "Exams")', { id: examId });
                    if (!p.ok) throw p.message;
                }
                await Swal.fire({ icon: 'success', title: publish ? lblPublished : lblSaved, timer: 1200, showConfirmButton: false, heightAuto: false });
                location.href = '@Url.Action("Index", "Exams")';
            } catch (e) {
                setBusy(false);
                if (e && e.status && sessionReplaced(e)) return;
                notify('error', typeof e === 'string' ? e : lblTryAgain);
            }
        }

        if (!questions.length && !locked) addQuestion();
        else render();
    </script>
}
