@model List<OnlineExamRow>
@inject CenterApp.Service.Services.IPermissionService Perm
@{
    ViewData["Title"] = L.Get("Menu.OnlineExams").Value;
    var canAdd = Perm.Has(User, Screens.Exams, PermissionAction.Add);
    var canEdit = Perm.Has(User, Screens.Exams, PermissionAction.Edit);
    var canDelete = Perm.Has(User, Screens.Exams, PermissionAction.Delete);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@L.Get("Menu.OnlineExams") <span class="badge bg-secondary">@Model.Count</span></h3>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Grades">@L.Get("Menu.OnlineGrades")</a>
        @if (canAdd)
        {
            <a class="btn btn-primary" asp-action="Edit">+ @L.Get("Exam.New")</a>
        }
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="panel empty-box">@L.Get("Exam.Empty")</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>@L.Get("Exam.TitleCol")</th>
                <th>@L.Get("Exam.Groups")</th>
                <th>@L.Get("Exam.Opens")</th>
                <th>@L.Get("Exam.Closes")</th>
                <th>@L.Get("Exam.Result")</th>
                <th>@L.Get("Exam.Score")</th>
                <th>@L.Get("Common.Status")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>
                        <strong>@m.Title</strong>
                        <div class="text-muted small">@L.Get("Exam.QuestionAttempts", m.QuestionsCount, m.AttemptsCount)</div>
                    </td>
                    <td><small>@m.Groups</small></td>
                    <td>@m.OpensAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@m.ClosesAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@m.ResultsAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@m.MaxScore.ToString("0.##")</td>
                    <td>
                        @if (m.Status == ExamStatus.Published)
                        {
                            <span class="badge bg-success">@L.Get("Exam.Published")</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@L.Get("Exam.Draft")</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-dark" asp-action="Grades" asp-route-id="@m.Id">@L.Get("Exam.Grades")</a>
                        @if (canEdit)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@m.Id">@L.Get("Common.Edit")</a>
                        }
                        @if (canDelete)
                        {
                            <button class="btn btn-sm btn-outline-danger" onclick='confirmPost("@Url.Action("Delete", "Exams")", { id: @m.Id }, @Json.Serialize(L.Get("Exam.DeleteAsk").Value))'>@L.Get("Common.Delete")</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
