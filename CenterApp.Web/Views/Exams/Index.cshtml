@model List<OnlineExamRow>
@inject CenterApp.Service.Services.IPermissionService Perm
@{
    ViewData["Title"] = "الاختبارات الأونلاين";
    var canAdd = Perm.Has(User, Screens.Exams, PermissionAction.Add);
    var canEdit = Perm.Has(User, Screens.Exams, PermissionAction.Edit);
    var canDelete = Perm.Has(User, Screens.Exams, PermissionAction.Delete);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>الاختبارات الأونلاين <span class="badge bg-secondary">@Model.Count</span></h3>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Grades">درجات الأونلاين</a>
        @if (canAdd)
        {
            <a class="btn btn-primary" asp-action="Edit">+ اختبار جديد</a>
        }
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="panel empty-box">لسه مفيش اختبارات أونلاين</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>العنوان</th>
                <th>المجموعات</th>
                <th>يفتح</th>
                <th>يقفل</th>
                <th>النتيجة</th>
                <th>الدرجة</th>
                <th>الحالة</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>
                        <strong>@m.Title</strong>
                        <div class="text-muted small">@m.QuestionsCount سؤال · @m.AttemptsCount محاولة</div>
                    </td>
                    <td><small>@m.Groups</small></td>
                    <td>@m.OpensAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@m.ClosesAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@m.ResultsAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@m.MaxScore.ToString("0.##")</td>
                    <td>
                        @if (m.Status == ExamStatus.Published)
                        {
                            <span class="badge bg-success">منشور</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">مسودة</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-dark" asp-action="Grades" asp-route-id="@m.Id">الدرجات</a>
                        @if (canEdit)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@m.Id">تعديل</a>
                        }
                        @if (canDelete)
                        {
                            <button class="btn btn-sm btn-outline-danger" onclick="confirmPost('@Url.Action("Delete", "Exams")', { id: @m.Id }, 'حذف الاختبار؟')">حذف</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
