@model List<OfflineExamRow>
@inject CenterApp.Service.Services.IPermissionService Perm
@{
    ViewData["Title"] = L.Get("Menu.OfflineGrades").Value;
    var canAdd = Perm.Has(User, Screens.Exams, PermissionAction.Add);
    var canEdit = Perm.Has(User, Screens.Exams, PermissionAction.Edit);
    var canDelete = Perm.Has(User, Screens.Exams, PermissionAction.Delete);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@L.Get("Offline.Heading") <span class="badge bg-secondary">@Model.Count</span></h3>
    @if (canAdd)
    {
        <a class="btn btn-primary" asp-action="Edit">+ @L.Get("Offline.NewPaper")</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="panel empty-box">@L.Get("Offline.Empty")</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>@L.Get("Offline.Exam")</th>
                <th>@L.Get("Common.Group")</th>
                <th>@L.Get("Offline.Date")</th>
                <th>@L.Get("Offline.MaxScore")</th>
                <th>@L.Get("Offline.Graded")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td><strong>@m.Title</strong></td>
                    <td>@m.GroupName</td>
                    <td>@m.ExamDate.ToString("yyyy-MM-dd")</td>
                    <td>@m.MaxScore.ToString("0.##")</td>
                    <td><span class="badge bg-primary">@m.GradedCount / @m.StudentCount</span></td>
                    <td class="text-nowrap">
                        @if (canEdit)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@m.Id">@L.Get("Offline.EnterGrades")</a>
                        }
                        @if (canDelete)
                        {
                            <button class="btn btn-sm btn-outline-danger" onclick='confirmPost("@Url.Action("Delete", "OfflineExams")", { id: @m.Id }, @Json.Serialize(L.Get("Offline.DeleteAsk").Value))'>@L.Get("Common.Delete")</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
