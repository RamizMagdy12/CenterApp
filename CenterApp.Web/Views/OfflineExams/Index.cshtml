@model List<OfflineExamRow>
@inject CenterApp.Service.Services.IPermissionService Perm
@{
    ViewData["Title"] = "رصد الأوفلاين";
    var canAdd = Perm.Has(User, Screens.Exams, PermissionAction.Add);
    var canEdit = Perm.Has(User, Screens.Exams, PermissionAction.Edit);
    var canDelete = Perm.Has(User, Screens.Exams, PermissionAction.Delete);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>رصد درجات الأوفلاين <span class="badge bg-secondary">@Model.Count</span></h3>
    @if (canAdd)
    {
        <a class="btn btn-primary" asp-action="Edit">+ امتحان ورقي</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="panel empty-box">لسه مفيش امتحانات أوفلاين. اعمل امتحان باسمه ودرجته، وبعدين ارصد درجات المجموعة.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>الامتحان</th>
                <th>المجموعة</th>
                <th>التاريخ</th>
                <th>الدرجة النهائية</th>
                <th>المرصود</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td><strong>@m.Title</strong></td>
                    <td>@m.GroupName</td>
                    <td>@m.ExamDate.ToString("yyyy-MM-dd")</td>
                    <td>@m.MaxScore.ToString("0.##")</td>
                    <td><span class="badge bg-primary">@m.GradedCount / @m.StudentCount</span></td>
                    <td class="text-nowrap">
                        @if (canEdit)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@m.Id">رصد الدرجات</a>
                        }
                        @if (canDelete)
                        {
                            <button class="btn btn-sm btn-outline-danger" onclick="confirmPost('@Url.Action("Delete", "OfflineExams")', { id: @m.Id }, 'حذف الامتحان ودرجاته؟')">حذف</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
