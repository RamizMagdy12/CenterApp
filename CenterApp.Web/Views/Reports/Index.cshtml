@model ReportPageVm
@{
    ViewData["Title"] = "تقارير الطلاب";
    var from = Model.From.ToString("yyyy-MM-dd");
    var to = Model.To.ToString("yyyy-MM-dd");
    string Tab(string kind) => Url.Action("Index", new { groupId = Model.GroupId, studentId = Model.StudentId, from, to, kind })!;
}
<style>
    .rpt-tabs { display: flex; gap: 8px; margin-bottom: 16px; }
    .rpt-tabs a {
        padding: 8px 16px;
        border-radius: 10px;
        background: #fff;
        border: 1px solid var(--line);
        color: var(--text);
        font-weight: 700;
    }
    .rpt-tabs a.active { background: var(--primary); color: #fff; border-color: var(--primary); }
    .sheet {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 16px;
    }
    .sheet-head { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; margin-bottom: 12px; }
    .sheet-head h2 { margin: 0; font-size: 20px; font-weight: 800; }
    .sheet-sub, .empty { color: var(--muted); font-size: 13px; }
    .sheet-brand { font-weight: 800; color: var(--primary); }
    .sheet h3 { font-size: 16px; font-weight: 800; margin: 16px 0 8px; }
    .meta, .grid { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
    .meta th, .meta td, .grid th, .grid td { border: 1px solid var(--line); padding: 8px 10px; text-align: right; }
    .meta th, .grid th { background: #f7f7fb; font-weight: 700; }
    .summary { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
    .summary span { background: #f7f7fb; border-radius: 10px; padding: 6px 10px; font-size: 13px; }
    .sign { margin-top: 22px; border-top: 1px dashed #c9cbe0; padding-top: 14px; }
    .sign-title { font-weight: 800; margin-bottom: 10px; }
    .sign-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .sign-grid span { display: block; font-size: 13px; color: var(--muted); }
    .line { display: block; min-height: 28px; border-bottom: 1px solid #1d2147; margin-top: 8px; }
    @@media (max-width: 768px) { .sign-grid { grid-template-columns: 1fr; } }
</style>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-3">
        <label class="form-label">المجموعة</label>
        <select name="groupId" class="form-select" onchange="this.form.studentId.value=''; this.form.submit()">
            <option value="0">-- اختر المجموعة --</option>
            @foreach (var g in Model.Groups)
            {
                <option value="@g.Id" selected="@(g.Id == Model.GroupId)">@g.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">من</label>
        <input type="date" name="from" value="@from" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">إلى</label>
        <input type="date" name="to" value="@to" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">الطالب</label>
        <select name="studentId" class="form-select">
            <option value="">كل الطلاب</option>
            @foreach (var s in Model.Students)
            {
                <option value="@s.Id" selected="@(Model.StudentId == s.Id)">@s.Name @(string.IsNullOrEmpty(s.Code) ? "" : "(" + s.Code + ")")</option>
            }
        </select>
    </div>
    <input type="hidden" name="kind" value="@Model.Kind" />
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">عرض</button>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div class="rpt-tabs">
        <a class="@(Model.Kind == "attendance" ? "active" : "")" href="@Tab("attendance")">الحضور</a>
        <a class="@(Model.Kind == "grades" ? "active" : "")" href="@Tab("grades")">الدرجات</a>
    </div>
    @if (Model.GroupId != 0)
    {
        <a class="btn btn-outline-primary" target="_blank"
           asp-action="Print"
           asp-route-groupId="@Model.GroupId"
           asp-route-studentId="@Model.StudentId"
           asp-route-from="@from"
           asp-route-to="@to"
           asp-route-kind="@Model.Kind">طباعة</a>
    }
</div>

@if (Model.GroupId == 0)
{
    <div class="panel"><div class="empty-box">اختار المجموعة والفترة عشان يظهر التقرير.</div></div>
}
else if (Model.Reports.Count == 0)
{
    <div class="panel"><div class="empty-box">مفيش طلاب في المجموعة خلال الفترة دي.</div></div>
}
else
{
    <p class="text-muted mb-2">عدد التقارير: @Model.Reports.Count</p>
    @foreach (var report in Model.Reports)
    {
        <partial name="_Sheet" model="new ReportSheetModel { Kind = Model.Kind, Report = report }" />
    }
}
