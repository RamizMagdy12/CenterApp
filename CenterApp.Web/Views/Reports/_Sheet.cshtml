@model ReportSheetModel
@{
    var r = Model.Report;
    var grades = Model.Kind == "grades";
    var title = grades ? L.Get("Report.GradesReport") : L.Get("Report.AttendanceReport");

    string AttLabel(AttendanceReportRow row) => !row.Recorded ? L.Get("Report.Unrecorded").Value : row.Status switch
    {
        AttendanceStatus.Present => L.Get("Att.Present").Value,
        AttendanceStatus.Absent => L.Get("Att.Absent").Value,
        AttendanceStatus.Excused => L.Get("Att.Excused").Value,
        AttendanceStatus.Late => L.Get("Att.Late").Value,
        _ => "—"
    };

    string ScoreText(GradeReportRow row) => row.Taken
        ? $"{row.Score:0.##} / {row.MaxScore:0.##}"
        : row.MissingLabel;

    string PercentText(GradeReportRow row)
    {
        if (!row.Taken || row.MaxScore <= 0 || row.Score == null) return "—";
        return ((row.Score.Value / row.MaxScore) * 100m).ToString("0.#") + "%";
    }

    string Average(List<GradeReportRow> rows)
    {
        var taken = rows.Where(x => x.Taken && x.MaxScore > 0 && x.Score != null).ToList();
        if (taken.Count == 0) return "—";
        var avg = taken.Average(x => (double)(x.Score!.Value / x.MaxScore * 100m));
        return avg.ToString("0.#") + "%";
    }
}
<article class="sheet">
    <header class="sheet-head">
        <div>
            <h2>@title</h2>
            <div class="sheet-sub">@L.Get("Report.FromTo", r.From.ToString("yyyy-MM-dd"), r.To.ToString("yyyy-MM-dd"))</div>
        </div>
        <div class="sheet-brand">@L.Get("App.Name")</div>
    </header>

    <table class="meta">
        <tr>
            <th>@L.Get("Common.Student")</th>
            <td>@r.StudentName</td>
            <th>@L.Get("Common.Code")</th>
            <td dir="ltr">@r.StudentCode</td>
        </tr>
        <tr>
            <th>@L.Get("Students.Parent")</th>
            <td>@(string.IsNullOrWhiteSpace(r.ParentName) ? "—" : r.ParentName)</td>
            <th>@L.Get("Common.Group")</th>
            <td>@r.GroupName</td>
        </tr>
        <tr>
            <th>@L.Get("Common.Subject")</th>
            <td>@r.SubjectName</td>
            <th>@L.Get("Common.Teacher")</th>
            <td>@r.TeacherName</td>
        </tr>
    </table>

    @if (!grades)
    {
        <div class="summary">
            <span>@L.Get("Att.Present") <b>@r.Present</b></span>
            <span>@L.Get("Att.Late") <b>@r.Late</b></span>
            <span>@L.Get("Att.Absent") <b>@r.Absent</b></span>
            <span>@L.Get("Att.Excused") <b>@r.Excused</b></span>
            <span>@L.Get("Report.Unrecorded") <b>@r.Unrecorded</b></span>
            <span>@L.Get("Report.AttendanceRate") <b>@r.Rate%</b></span>
        </div>
        @if (r.Attendance.Count == 0)
        {
            <p class="empty">@L.Get("Report.NoSessions")</p>
        }
        else
        {
            <table class="grid">
                <thead>
                    <tr>
                        <th>@L.Get("Report.Date")</th>
                        <th>@L.Get("Report.Day")</th>
                        <th>@L.Get("Report.From")</th>
                        <th>@L.Get("Report.To")</th>
                        <th>@L.Get("Common.Status")</th>
                        <th>@L.Get("Report.Note")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in r.Attendance)
                    {
                        <tr>
                            <td>@row.Date.ToString("yyyy-MM-dd")</td>
                            <td>@ArabicDays.Name(row.Date.DayOfWeek)</td>
                            <td>@row.Start.ToString(@"hh\:mm")</td>
                            <td>@row.End.ToString(@"hh\:mm")</td>
                            <td>@AttLabel(row)</td>
                            <td>@row.Note</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    else
    {
        <h3>@L.Get("Report.OnlineExams")</h3>
        <div class="summary">
            <span>@L.Get("Report.ExamCount") <b>@r.Online.Count</b></span>
            <span>@L.Get("Report.Average") <b>@Average(r.Online)</b></span>
        </div>
        @if (r.Online.Count == 0)
        {
            <p class="empty">@L.Get("Report.NoOnline")</p>
        }
        else
        {
            <table class="grid">
                <thead>
                    <tr>
                        <th>@L.Get("Report.Exam")</th>
                        <th>@L.Get("Report.Date")</th>
                        <th>@L.Get("Report.Score")</th>
                        <th>@L.Get("Report.Percent")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in r.Online)
                    {
                        <tr>
                            <td>@row.Title</td>
                            <td>@row.Date.ToString("yyyy-MM-dd")</td>
                            <td>@ScoreText(row)</td>
                            <td>@PercentText(row)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <h3>@L.Get("Report.OfflineExams")</h3>
        <div class="summary">
            <span>@L.Get("Report.ExamCount") <b>@r.Offline.Count</b></span>
            <span>@L.Get("Report.Average") <b>@Average(r.Offline)</b></span>
        </div>
        @if (r.Offline.Count == 0)
        {
            <p class="empty">@L.Get("Report.NoOffline")</p>
        }
        else
        {
            <table class="grid">
                <thead>
                    <tr>
                        <th>@L.Get("Report.Exam")</th>
                        <th>@L.Get("Report.Date")</th>
                        <th>@L.Get("Report.Score")</th>
                        <th>@L.Get("Report.Percent")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in r.Offline)
                    {
                        <tr>
                            <td>@row.Title</td>
                            <td>@row.Date.ToString("yyyy-MM-dd")</td>
                            <td>@ScoreText(row)</td>
                            <td>@PercentText(row)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    <footer class="sign">
        <div class="sign-title">@L.Get("Report.ParentSign")</div>
        <div class="sign-grid">
            <div>
                <span>@L.Get("Common.Name")</span>
                <span class="line">@(string.IsNullOrWhiteSpace(r.ParentName) ? "" : r.ParentName)</span>
            </div>
            <div>
                <span>@L.Get("Report.Signature")</span>
                <span class="line"></span>
            </div>
            <div>
                <span>@L.Get("Report.Date")</span>
                <span class="line"></span>
            </div>
        </div>
    </footer>
</article>
